{
  "directory": "/srv/zinc",
  "store": "/srv/zinc/private/history.db",
  "input": "text",
  "inspect": true,
  "rewind": true,
  "world": "main",
  "worlds": ["main"],
  "queue": true,
  "memory-retrieval": false,
  "summary-bytes": 512,
  "summary-max-bytes": 4096,
  "vm": {
    "user": {
      "bindings": ["*"],
      "fs": {},
      "http": {},
      "processes": {},
      "modules": {}
    },
    "agent": {
      "bindings": ["*"],
      "fs": {},
      "http": {},
      "processes": {},
      "modules": {}
    }
  },
  "providers": {
    "llamacpp": {
      "url": "http://127.0.0.1:8080",
      "protocol": "chat-completions",
      "catalogue": { "chat": "/v1/models" },
      "properties": "/props?model={model}",
      "parameters": { "reasoning_format": "deepseek" }
    }
  },
  "chat": "llamacpp:YOUR_MODEL_ID",
  "thinking": "default"
}

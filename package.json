{
  "name": "zinc",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "bin": {
    "zn": "./bin/zn.js"
  },
  "files": [
    "dist",
    "bin",
    "agent",
    "defaults",
    "README.md",
    "SPEC.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "edge bin/dev.js",
    "start": "edge dist/web.js",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "edge web/build.mjs",
    "build": "edge -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && npm run build:host && npm run build:client",
    "test": "npm run build:host && edge test/build.mjs && edge --test .test-build/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "uninstall:zinc": "edge bin/uninstall.js"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@babel/parser": "^7.29.7",
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@babel/preset-typescript": "^7.28.5",
    "@darkhorseprojects/circuitry": "../circuitry",
    "@kobalte/core": "^0.13.11",
    "@lexical/code": "^0.46.0",
    "@lexical/code-core": "^0.46.0",
    "@lexical/extension": "^0.46.0",
    "@lexical/history": "^0.46.0",
    "@lexical/link": "^0.46.0",
    "@lexical/list": "^0.46.0",
    "@lexical/markdown": "^0.46.0",
    "@lexical/rich-text": "^0.46.0",
    "@lexical/table": "^0.46.0",
    "@lexical/text": "^0.46.0",
    "@lexical/utils": "^0.46.0",
    "@phosphor-icons/core": "^2.1.1",
    "@stylexjs/stylex": "^0.19.0",
    "@tanstack/solid-virtual": "^3.13.33",
    "@tursodatabase/database": "^0.6.1",
    "@types/node": "^26.0.1",
    "animejs": "^4.5.0",
    "babel-preset-solid": "^1.9.12",
    "diff": "^8.0.4",
    "katex": "^0.16.47",
    "kdljs": "^0.3.0",
    "lexical": "^0.46.0",
    "marked": "^18.0.6",
    "solid-js": "^1.9.5",
    "sugar-high": "^1.2.1"
  },
  "overrides": {
    "lodash-es": "^4.18.1"
  },
  "devDependencies": {
    "@stylexjs/babel-plugin": "^0.19.0",
    "@types/babel__core": "^7.20.5",
    "esbuild": "^0.28.1",
    "typescript": "7.0.2"
  }
}

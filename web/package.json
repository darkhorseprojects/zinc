{
  "name": "zinc-web",
  "type": "module",
  "packageManager": "bun@1.3.14-canary.1",
  "scripts": {
    "dev": "bun run build:client && bun --watch src/server/index.ts",
    "build": "bun run build:client && bun run build:server",
    "build:client": "vite build",
    "build:server": "bun build src/server/index.ts --target=bun --outdir=dist/server",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "bun dist/server/index.js"
  },
  "dependencies": {
    "@darkhorseprojects/circuitry": "../../circuitry",
    "@kobalte/core": "^0.13.11",
    "@kobalte/tailwindcss": "^0.9.0",
    "@lexical/code": "^0.46.0",
    "@lexical/history": "^0.46.0",
    "@lexical/html": "^0.46.0",
    "@lexical/link": "^0.46.0",
    "@lexical/list": "^0.46.0",
    "@lexical/markdown": "^0.46.0",
    "@lexical/rich-text": "^0.46.0",
    "@lexical/selection": "^0.46.0",
    "@lexical/text": "^0.46.0",
    "@lexical/utils": "^0.46.0",
    "@mdx-js/mdx": "^3.1.1",
    "@phosphor-icons/core": "^2.1.1",
    "@tailwindcss/vite": "^4.3.1",
    "@tursodatabase/database": "^0.6.1",
    "@types/node": "^26.0.1",
    "animejs": "^4.5.0",
    "autoprefixer": "^10.5.0",
    "kdljs": "^0.3.0",
    "lexical": "^0.46.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-mdx": "^3.0.0",
    "mdast-util-to-markdown": "^2.1.2",
    "postcss": "^8.5.15",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "solid-js": "^1.9.5",
    "tailwindcss": "^4.3.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.8"
  },
  "devDependencies": {
    "vitest": "^4.1.9",
    "@types/bun": "^1.3.5"
  }
}

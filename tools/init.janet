(import spork/json :as json)
(import ../src/config)
(import ../src/store)

(unless (index-of (os/which) [:windows :mingw]) (os/umask 8r077))
(def deployment (json/decode (slurp "ac.json") true true))
(def settings (values (deployment :policies)))
(assert (and (not (empty? settings))
  (= 1 (length (distinct (map |[($ :handle) (get-in $ [:config :directory]) (get-in $ [:config :store])] settings)))))
  "policies must share one Zinc handle, directory and store")
(def policy (first settings))
(def c (config/parse (policy :config) (policy :handle) "initialize"))
(assert (not (c :temporary)) "initialization requires a durable store")
(def s (store/open c true))
(store/close s)
(print "Initialized " (c :store))

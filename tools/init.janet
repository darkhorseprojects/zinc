(import spork/json :as json)
(import ../src/policy)
(import ../src/store)

(unless (index-of (os/which) [:windows :mingw]) (os/umask 8r077))
(def handle (os/getenv "PA_HANDLE"))
(assert (and handle (not (empty? handle))) "PA_HANDLE required")
(def c (policy/parse (json/decode (file/read stdin :all) true true) handle "initialize"))
(assert (not (c :temporary)) "initialization requires a durable store")
(def s (store/open c true))
(store/close s)
(print "Initialized " (c :store))

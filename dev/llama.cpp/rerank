#!/bin/sh
set -eu

MODEL="${MODEL:-$HOME/.cache/huggingface/hub/models--ggml-org--Qwen3-Reranker-0.6B-Q8_0-GGUF/snapshots/main/qwen3-reranker-0.6b-q8_0.gguf}"
PORT="${PORT:-8002}"
HOST="${HOST:-127.0.0.1}"
LLAMA_SERVER="${LLAMA_SERVER:-$HOME/dev/llama.cpp/build/bin/llama-server}"

exec "$LLAMA_SERVER" \
  -m "$MODEL" \
  --reranking \
  --pooling rank \
  -np 1 \
  -c 2048 \
  -b 2048 \
  -ub 2048 \
  --host "$HOST" \
  --port "$PORT" \
  -ngl 99

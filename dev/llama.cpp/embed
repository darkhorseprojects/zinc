#!/bin/sh
set -eu

MODEL="${MODEL:-$HOME/.cache/huggingface/hub/models--Qwen--Qwen3-Embedding-0.6B-GGUF/snapshots/main/Qwen3-Embedding-0.6B-Q8_0.gguf}"
PORT="${PORT:-8001}"
HOST="${HOST:-127.0.0.1}"
LLAMA_SERVER="${LLAMA_SERVER:-$HOME/dev/llama.cpp/build/bin/llama-server}"

exec "$LLAMA_SERVER" \
  -m "$MODEL" \
  --embedding \
  --pooling mean \
  -c 8192 \
  -b 8192 \
  -ub 8192 \
  --host "$HOST" \
  --port "$PORT" \
  -ngl 99

// OpenAI-compatible adapter config.
// Used by openai-responses.py for local and remote model endpoints.

// Required:
// base-url "http://127.0.0.1:30000/v1"
// model    "your-model-name"

// Optional inference params (omit to use server defaults):
// temperature      0.7
// max-tokens       4096
// top-p            0.95

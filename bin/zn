#!/usr/bin/env python3
import base64
import json
import os
import shutil
import signal
import sqlite3
import subprocess
import sys
import time
from pathlib import Path

BLUE = "\033[34m"
RESET = "\033[0m"
ROOT = Path(__file__).resolve().parent.parent
WEB = ROOT / "web"
AGENT_TEMPLATES = ROOT / "agent"
AGENT_FILES = ["turn.md", "openai-responses.py", "openai-responses.kdl", "shell.py", "requirements.txt"]
PACKET_OVERFLOW_MAGIC = b"zinc-packet-overflow-v1\n"

SCHEMA = [
    "create table if not exists meta (key text primary key, value text not null)",
    "create table if not exists packets (id text primary key, parent text, at integer not null, bytes blob not null)",
    "create table if not exists threads (id text primary key, title text, body text not null, updated integer not null)",
]


def blue(message: str) -> None:
    print(f"{BLUE}{message}{RESET}")


def default_zinc_home() -> Path:
    if os.environ.get("ZINC_HOME"):
        return Path(os.environ["ZINC_HOME"]).expanduser()
    if sys.platform == "darwin":
        return Path.home() / "Library" / "Application Support" / "Zinc"
    if sys.platform.startswith("win"):
        return Path(os.environ.get("APPDATA", Path.home())) / "Zinc"
    return Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "zinc"


def resolve_path(value: str | Path, base: Path | None = None) -> Path:
    path = Path(value).expanduser()
    if not path.is_absolute():
        path = (base or Path.cwd()) / path
    return path.resolve()


def option(args: list[str], name: str) -> str | None:
    if name not in args:
        return None
    index = args.index(name)
    try:
        value = args[index + 1]
    except IndexError:
        raise SystemExit(f"{name} requires a value")
    del args[index:index + 2]
    return value


def init_db(store_path: Path) -> None:
    store_path.parent.mkdir(parents=True, exist_ok=True)
    with sqlite3.connect(store_path) as db:
        for sql in SCHEMA:
            db.execute(sql)
        db.execute("insert or replace into meta (key, value) values ('schema_version', '1')")
    blue(f"initialized {store_path}")


def copy_agent_templates(agent_dir: Path, *, overwrite: bool = False) -> None:
    agent_dir.mkdir(parents=True, exist_ok=True)
    for name in AGENT_FILES:
        src = AGENT_TEMPLATES / name
        dst = agent_dir / name
        if not src.exists() or (dst.exists() and not overwrite):
            continue
        shutil.copy2(src, dst)
        if name.endswith(".py"):
            dst.chmod(0o755)
        blue(f"wrote {dst}")


def agent_python(agent_dir: Path) -> Path:
    return agent_dir / (".venv/Scripts/python.exe" if sys.platform.startswith("win") else ".venv/bin/python")


def write_config(path: Path, store: Path, zinc_dir: Path, agent_dir: Path, *, overwrite: bool = False) -> None:
    if path.exists() and not overwrite:
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(
        "\n".join([
            f"store {json.dumps(str(store))}",
            f"turn {json.dumps(str(agent_dir / 'turn.md'))}",
            f"zinc-dir {json.dumps(str(zinc_dir))}",
            f"agent-dir {json.dumps(str(agent_dir))}",
            f"python {json.dumps(str(agent_python(agent_dir)))}",
            "raw-context-bytes 8192",
            "packet-overflow-bytes 65536",
            "",
        ]),
        encoding="utf8",
    )
    blue(f"wrote {path}")


def register_store(zinc_dir: Path, store: Path) -> None:
    registry = zinc_dir / "registry.jsonl"
    entry = json.dumps({"path": str(store), "name": store.stem, "meta": {}})
    existing: list[str] = []
    if registry.exists():
        for line in registry.read_text(encoding="utf8").splitlines():
            if not line.strip():
                continue
            try:
                item = json.loads(line)
                if item.get("path") == str(store):
                    continue
                existing.append(line)
            except json.JSONDecodeError:
                continue
    registry.parent.mkdir(parents=True, exist_ok=True)
    registry.write_text("\n".join([entry] + existing) + "\n", encoding="utf8")


def initialize_home(zinc_dir: Path, store: Path, config: Path) -> None:
    init_db(store)
    agent_dir = zinc_dir / "agent"
    copy_agent_templates(agent_dir)
    write_config(config, store, zinc_dir, agent_dir)
    register_store(zinc_dir, store)
    print(f"Edit agent files in {agent_dir}")


def parse_config(path: Path | None = None) -> dict[str, Path]:
    config = resolve_path(path or os.environ.get("ZINC_CONFIG") or default_zinc_home() / "config.kdl")
    if not config.exists():
        raise SystemExit(f"config not found: {config}")
    base = config.parent
    values: dict[str, str] = {}
    for raw_line in config.read_text(encoding="utf8").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("//") or line.endswith("{") or line == "}":
            continue
        parts = line.split(None, 1)
        if len(parts) != 2:
            continue
        key, raw_value = parts
        parsed = parse_single_kdl_argument(raw_value)
        if isinstance(parsed, str):
            values[key] = parsed
    zinc_dir = resolve_path(values.get("zinc-dir") or values.get("zincDir") or config.parent, base)
    agent_dir = resolve_path(values.get("agent-dir") or values.get("agentDir") or zinc_dir / "agent", base)
    return {
        "config": config,
        "store": resolve_path(require(values, "store"), base),
        "turn": resolve_path(require(values, "turn"), base),
        "zinc_dir": zinc_dir,
        "agent_dir": agent_dir,
        "python": resolve_path(values.get("python") or agent_python(agent_dir), base),
        "web_pid": zinc_dir / "web.pid",
        "web_log": zinc_dir / "web.log",
    }


def parse_single_kdl_argument(raw_value: str) -> str:
    values = parse_kdl_arguments(raw_value)
    return values[0] if values else ""


def parse_kdl_arguments(raw_value: str) -> list[str]:
    decoder = json.JSONDecoder()
    values: list[str] = []
    index = 0
    while index < len(raw_value):
        while index < len(raw_value) and raw_value[index].isspace():
            index += 1
        if index >= len(raw_value):
            break
        if raw_value[index] == '"':
            value, index = decoder.raw_decode(raw_value, index)
            values.append(str(value))
            continue
        end = index
        while end < len(raw_value) and not raw_value[end].isspace():
            end += 1
        values.append(raw_value[index:end])
        index = end
    return values


def require(values: dict[str, str], key: str) -> str:
    value = values.get(key)
    if not value:
        raise SystemExit(f"{key} is required in config.kdl")
    return value


def command_init(args: list[str]) -> None:
    home = resolve_path(option(args, "--home") or default_zinc_home())
    store = resolve_path(option(args, "--store") or home / "zinc.db")
    config = resolve_path(option(args, "--config") or home / "config.kdl")
    initialize_home(home, store, config)


def command_here(_args: list[str]) -> None:
    zinc_dir = (Path.cwd() / ".zinc").resolve()
    initialize_home(zinc_dir, zinc_dir / "zinc.db", zinc_dir / "config.kdl")


def command_up(args: list[str]) -> None:
    config_arg = option(args, "--config")
    config = parse_config(Path(config_arg) if config_arg else None)
    pid = read_pid(config["web_pid"])
    if pid and process_running(pid):
        print(f"zinc web already running pid={pid}")
        return

    config["zinc_dir"].mkdir(parents=True, exist_ok=True)
    log = open(config["web_log"], "ab", buffering=0)
    env = os.environ.copy()
    env["ZINC_CONFIG"] = str(config["config"])
    kwargs = {}
    if sys.platform.startswith("win"):
        kwargs["creationflags"] = subprocess.CREATE_NEW_PROCESS_GROUP | subprocess.DETACHED_PROCESS
    else:
        kwargs["start_new_session"] = True
    child = subprocess.Popen(
        ["bun", "run", "start"],
        cwd=WEB,
        env=env,
        stdin=subprocess.DEVNULL,
        stdout=log,
        stderr=subprocess.STDOUT,
        **kwargs,
    )
    config["web_pid"].write_text(str(child.pid), encoding="utf8")
    blue(f"started zinc web pid={child.pid}")
    print(f"logs: {config['web_log']}")


def command_down(args: list[str]) -> None:
    config_arg = option(args, "--config")
    config = parse_config(Path(config_arg) if config_arg else None)
    pid = read_pid(config["web_pid"])
    if not pid or not process_running(pid):
        remove_if_exists(config["web_pid"])
        print("zinc web is not running")
        return
    stop_process(pid)
    remove_if_exists(config["web_pid"])
    blue(f"stopped zinc web pid={pid}")


def command_status(args: list[str]) -> None:
    config_arg = option(args, "--config")
    config = parse_config(Path(config_arg) if config_arg else None)
    pid = read_pid(config["web_pid"])
    if pid and process_running(pid):
        print(f"running pid={pid}")
    else:
        print("stopped")


def command_logs(args: list[str]) -> None:
    lines_arg = option(args, "--lines")
    lines = int(lines_arg) if lines_arg else 200
    config_arg = option(args, "--config")
    config = parse_config(Path(config_arg) if config_arg else None)
    if not config["web_log"].exists():
        print(f"no log file: {config['web_log']}")
        return
    content = config["web_log"].read_text(encoding="utf8", errors="replace").splitlines()
    print("\n".join(content[-lines:]))


def read_pid(path: Path) -> int | None:
    try:
        return int(path.read_text(encoding="utf8").strip())
    except (FileNotFoundError, ValueError):
        return None


def process_running(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def stop_process(pid: int) -> None:
    os.kill(pid, signal.SIGTERM)
    for _ in range(30):
        if not process_running(pid):
            return
        time.sleep(0.1)
    if hasattr(signal, "SIGKILL"):
        os.kill(pid, signal.SIGKILL)


def remove_if_exists(path: Path) -> None:
    try:
        path.unlink()
    except FileNotFoundError:
        pass


def store_from_args(args: list[str]) -> Path:
    explicit = option(args, "--store")
    if explicit:
        return resolve_path(explicit)
    if os.environ.get("ZINC_STORE"):
        return resolve_path(os.environ["ZINC_STORE"])
    config_arg = option(args, "--config")
    return parse_config(Path(config_arg) if config_arg else None)["store"]


def read_packet_bytes(stored: bytes) -> bytes:
    if not stored.startswith(PACKET_OVERFLOW_MAGIC):
        return stored
    raw = stored[len(PACKET_OVERFLOW_MAGIC):].strip()
    try:
        marker = json.loads(raw.decode("utf8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise SystemExit(f"invalid packet overflow marker: {error}")
    path = Path(str(marker.get("path", "")))
    size = int(marker.get("size", -1))
    tail = base64.b64decode(str(marker.get("tail", "")))
    if not path.is_file():
        raise SystemExit(f"packet overflow file not found: {path}")
    data = path.read_bytes()
    if len(data) != size:
        raise SystemExit(f"packet overflow size mismatch: {path}")
    if tail and not data.endswith(tail):
        raise SystemExit(f"packet overflow tail mismatch: {path}")
    return data


def command_packet(args: list[str]) -> None:
    sub = args.pop(0) if args else ""
    if sub != "read":
        raise SystemExit("usage: zn packet read --packet ID [--store PATH] [--range A:B]")
    packet = option(args, "--packet")
    if not packet:
        raise SystemExit("--packet is required")
    byte_range = option(args, "--range")
    store = store_from_args(args)
    with sqlite3.connect(store) as db:
        row = db.execute("select bytes from packets where id = ?", (packet,)).fetchone()
    if row is None:
        raise SystemExit(f"packet not found: {packet}")
    data = read_packet_bytes(bytes(row[0]))
    if byte_range:
        left, _, right = byte_range.partition(":")
        start = int(left) if left else None
        end = int(right) if right else None
        data = data[start:end]
    sys.stdout.buffer.write(data)


def command_thread(args: list[str]) -> None:
    sub = args.pop(0) if args else ""
    store = store_from_args(args)
    with sqlite3.connect(store) as db:
        if sub == "list":
            for thread_id, title, updated in db.execute("select id, title, updated from threads order by updated desc"):
                print(f"{thread_id}\t{title or ''}\t{updated}")
            return
        if sub == "read":
            thread = option(args, "--thread")
            if not thread:
                raise SystemExit("--thread is required")
            row = db.execute("select body from threads where id = ?", (thread,)).fetchone()
            if row is None:
                raise SystemExit(f"thread not found: {thread}")
            print(row[0])
            return
    raise SystemExit("usage: zn thread list|read")


def print_help() -> None:
    print("zn init|here|up|down|logs|status|packet|thread")


def main(argv: list[str]) -> int:
    command = argv.pop(0) if argv else "help"
    if command == "init":
        command_init(argv)
    elif command == "here":
        command_here(argv)
    elif command == "up":
        command_up(argv)
    elif command == "down":
        command_down(argv)
    elif command == "logs":
        command_logs(argv)
    elif command == "status":
        command_status(argv)
    elif command == "packet":
        command_packet(argv)
    elif command == "thread":
        command_thread(argv)
    elif command == "help":
        print_help()
    else:
        raise SystemExit(f"unknown command: {command}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))

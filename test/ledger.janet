(import ../src/store :as st)
(import ../src/memory :as memory)
(import ../src/model :as model)
(import sqlite3 :as sql)

(def config {:store ":memory:" :actor "ledger-test" :world "empty" :worlds ["empty" "secret"] :providers {} :visibility []
             :revision (string/repeat "a" 40) :budget 1000 :parallel 1 :lease-seconds 3 :task-depth 8 :task-quota 4096
             :source-bytes 65536 :response-bytes 8388608 :tool-quota 65536 :tool-result-units 2048
             :history-records 1024 :compact-source-units 4096 :context-units 2048 :soft-units 1024 :summary-units 256})
(def s (st/open config))
(defer (st/close s)
  (def branch (st/start s {:text "visible flamingo" :parent 0 :request "root"} config nil {:origin "empty" :base 0 :bindings [] :state {}}))
  (assert (= (branch "id") ((st/start s {:text "visible flamingo" :parent 0 :request "root"} config nil {}) "id")))
  (assert (try (do (st/start s {:text "conflict" :parent 0 :request "root"} config nil {}) false) ([err] true)))
  (st/start s {:text "hidden flamingoes" :world "secret" :parent 0} config nil {:origin "secret" :base 0 :bindings [] :state {}})
  (def view (merge (st/view s (branch "id")) {:first 1 :last 9007199254740991 :history-last 9007199254740991 :imports [] :capabilities []}))
  (assert (= ["flamingo"] (tuple/slice (map |($ "term") (st/visible s (merge view {:lexical true :match "\"fla\"" :columns "DISTINCT l.term"}) :oldest 128)))))
  (assert (= 0 (length (st/visible s (merge view {:first 0 :last 0})))))
  (def empty (st/append s view "artifact" ""))
  (assert (= "" ((memory/read s view {:event (empty "id")} 0 1) :text)))
  (def event (st/append s view "artifact" "😀éA"))
  (assert (= "😀" ((memory/read s view {:event (event "id")} 0 1) :text)))
  (assert (= "é" ((memory/read s view {:event (event "id")} 4 1) :text)))
  (assert (try (do (memory/read s view {:event (event "id")} 1 1) false) ([err] true)))
  (assert (try (do (memory/read s view {:event (event "id")} 100 1) false) ([err] true)))
  (assert (try (do (st/query s "UPDATE events SET text='changed' WHERE id=?" [(event "id")]) false) ([err] true)))
  (def a (st/append s view "artifact" (string/repeat "original one " 100)))
  (def b (st/append s view "artifact" (string/repeat "original two " 100)))
  (def parent (memory/summary s view [{:event (a "id")} {:event (b "id")}] "chronological synopsis" nil))
  (assert (= 2 (length (memory/expand s view {:node parent}))))
  (assert (= (a "text") ((memory/describe s view {:event (a "id")}) "text")))
  (assert (try (do (memory/describe s (merge view {:first (b "id")}) {:node parent}) false) ([err] true)))
  (def root (st/submit s view "operation" {:name "probe"} {:policy "safe" :key "root-job"}))
  (def claim (st/claim s root))
  (assert (nil? (st/claim s root)))
  (with-dyns [:zinc/task @{:id root :owner (claim "owner") :generation (claim "attempt") :scope view :checkpoint {}}]
    (st/checkpoint s {:phase "known-boundary"})
    (def admission (model/allowance s {:reference "llama:test"} {} 100 200))
    (assert (= 300 (model/spent s (view :run))))
    (st/park s true)
    (assert (= "waiting" ((st/task s root) "state")))
    (st/park s false)
    (st/query s "UPDATE leases SET expires=0 WHERE task=?" [root])
    (st/recover s)
    (assert (= "queued" ((st/task s root) "state")))
    (def next (st/claim s root))
    (assert (try (do (st/finish s claim "stale" nil) false) ([err] true)))
    (st/finish s next "known outcome" nil)
    (assert (try (do (st/finish s next "duplicate" nil) false) ([err] true))))
  (def late (st/start s {:text "late completion" :parent 0} config nil {:origin "empty" :base 0 :bindings [] :state {}}))
  (def late-view (merge view {:run (late "run") :branch (late "id")}))
  (def irreversible (st/submit s late-view "eval" {:code "(+ 1 2)" :tool-id "uncertain" :response (a "id")} {:policy "irreversible"}))
  (def lease (st/claim s irreversible))
  (st/query s "UPDATE leases SET expires=0 WHERE task=?" [irreversible])
  (st/recover s)
  (assert (= "uncertain" ((st/task s irreversible) "state")))
  (assert (nil? (st/claim s irreversible)))
  (st/finish s lease 3 nil)
  (assert (= "done" ((st/task s irreversible) "state")))
  (assert (= "ok" (((st/query s "PRAGMA integrity_check") 0) "integrity_check")))
  (assert (= 0 (length (st/query s "PRAGMA foreign_key_check"))))
  (print "PASS scoped FTS/trigram, UTF-8 originals, summary ancestry, immutable facts, admission dedup, shared reservations, slot parking, recovery/fencing, ambiguity and late completion"))

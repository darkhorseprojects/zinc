(import spork/http :as http)
(import spork/path :as path)
(import spork/utf8 :as utf8)
(import spork/json :as json)
(import jsec/tls :as tls)
(import ./config)
(import ./model)

(defn process [argv environment limit seconds &opt diagnostics]
  (def child (os/spawn argv :e (merge environment {:in :pipe :out :pipe :err (if diagnostics :pipe :out)})))
  (defer (do (when (nil? (get child :return-code)) (try (os/proc-kill child) ([err] nil))) (os/proc-close child))
    (def output @"") (var size 0)
    (ev/close (child :in))
    (def [_ _ exit] (ev/with-deadline (if (= 0 seconds) math/inf seconds)
      (ev/gather
        (do (var chunk nil) (while (set chunk (ev/read (child :out) 4096))
          (+= size (length chunk)) (assert (<= size limit) "process output limit") (buffer/push-string output chunk)))
        (when diagnostics (var chunk nil) (while (set chunk (ev/read (child :err) 4096))
          (+= size (length chunk)) (assert (<= size limit) "process output limit") (buffer/push-string diagnostics chunk)))
        (os/proc-wait child))))
    (assert (utf8/is-valid? output) "process output is not UTF-8") {:exit exit :output (string output)}))

(defn request [c endpoint method suffix &opt body prepared updates]
  (def headers (merge {:Content-Type "application/json" :Accept "application/json, text/event-stream"} (get endpoint :headers {})))
  (def secrets @[]) (var connection nil) (var secure false) (var attempted false)
  (try
    (ev/with-deadline (if (= 0 (c :http-ms)) math/inf (/ (c :http-ms) 1000))
      (when (endpoint :token-env)
        (def secret (os/getenv (endpoint :token-env))) (assert (and secret (> (length secret) 0)) "missing provider credential")
        (array/push secrets secret) (put headers :Authorization (string "Bearer " secret)))
      (when (endpoint :credential-command)
        (def diagnostics @"")
        (def credential (process (endpoint :credential-command) (os/environ) 16384 30 diagnostics))
        (assert (= 0 (credential :exit)) {:code "CredentialCommandFailed" :message "Credential command failed." :detail (string diagnostics)})
        (def supplied (json/decode (credential :output) true true))
        (each v (values supplied) (assert (string? v) "invalid credential header") (array/push secrets v)
          (when (string/has-prefix? "Bearer " v) (array/push secrets (string/slice v 7))))
        (merge-into headers supplied))
      (each [k v] (pairs headers)
        (assert (and (peg/match ~(* (some (set "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-")) -1) (string k))
          (string? v) (not (string/find "\r" v)) (not (string/find "\n" v))) "invalid HTTP header"))
      (def url (string (endpoint :url) suffix))
      (assert (peg/match ~(* (choice "https://" "http://") (some (if-not (set "@# \t\r\n") 1)) -1) url) "invalid HTTP URL")
      (defer (when connection (if secure (:close connection true) (ev/close connection)))
        (def response (http/open-stream url :method method :body body :headers headers :max-redirects 0
          :stream-factory (fn [host port opts]
            (set secure (= "https" (opts :scheme)))
            (set connection (ev/with-deadline 10 (if secure
              (tls/connect host port {:verify true :hostname host :verify-hostname host :alpn ["http/1.1"]})
              (net/connect host port))))
            (set attempted true) connection)))
        (if prepared
          (do
            (assert (<= 200 (response :status) 299) {:code "ProviderRejected" :message (string "Provider returned HTTP " (response :status))})
            (model/receive prepared response (c :response-bytes) updates))
          (do
            (def bytes @"")
            (each chunk (:blocks response 4096)
              (assert (<= (+ (length bytes) (length chunk)) (c :response-bytes)) "HTTP response limit")
              (buffer/push-string bytes chunk))
            (assert (utf8/is-valid? bytes) "HTTP response is not UTF-8")
            {:status (response :status) :headers (response :headers) :body (string bytes)}))))
    ([err fiber]
      (def d (config/diagnostic err fiber))
      (each k [:message :detail] (when (d k)
        (put d k (reduce (fn [text secret] (string/replace-all secret "[redacted]" text)) (d k) secrets))))
      (put d :context (merge (or (d :context) {}) {:outcome (if attempted "unknown" "error")})) (error d))))

(defn catalogue [c]
  (def records @{}) (def properties @{})
  (each [name endpoint] (pairs (c :providers))
    (def rows @[])
    (each [role suffix] (pairs (get endpoint :catalogue {}))
      (def response (request c endpoint "GET" suffix))
      (assert (<= 200 (response :status) 299) "model catalogue failed")
      (each r ((json/decode (response :body) true true) :data) (array/push rows (merge r {:role (string role)}))))
    (put records name rows)
    (when (endpoint :properties)
      (each r rows
        (def id (r :id))
        (def encoded (string/join (map |(if (or (<= 48 $ 57) (<= 65 $ 90) (<= 97 $ 122) (index-of $ [45 46 95 126]))
          (string/from-bytes $) (string/format "%%%02X" $)) (string/bytes id))))
        (def response (request c endpoint "GET" (string/replace-all "{model}" encoded (endpoint :properties))))
        (assert (<= 200 (response :status) 299) "model properties failed")
        (put properties (string name ":" id) (json/decode (response :body) true true)))))
  (model/catalogue c records properties))

(defn invoke [c spec binding args &opt updates]
  (cond
    (spec :module) (apply (module/value (require (get-in spec [:module :module])) (symbol (get-in spec [:module :export]))) args)
    (index-of binding ["model/chat" "model/rerank"])
    (let [prepared (first args) endpoint (get-in c [:providers (keyword (prepared :provider))])]
      (if (prepared :rerank)
        (let [response (request c endpoint "POST" (prepared :path) (prepared :body))]
          (assert (<= 200 (response :status) 299) {:code "ProviderRejected" :message (string "Provider returned HTTP " (response :status))})
          (model/decode prepared (json/decode (response :body) true true)))
        (request c endpoint "POST" (prepared :path) (prepared :body) prepared updates)))
    (index-of binding ["fs/list" "fs/read" "fs/write"])
    (do
      (assert (= (length args) (if (= binding "fs/write") 3 2)) "invalid filesystem arguments")
      (def [name relative text] args) (def grant (get-in c [:fs (keyword name)]))
      (assert (and grant (grant (if (= binding "fs/write") :write :read))) "filesystem permission denied")
      (assert (and (string? relative) (> (length relative) 0) (not (path/abspath? relative))
        (not (string/find "\\" relative)) (not (string/find ":" relative)) (not (string/find "\0" relative))) "invalid relative path")
      (var target (os/realpath (grant :root)))
      (each part (if (= relative ".") [] (string/split "/" relative))
        (assert (and (> (length part) 0) (not (index-of part ["." ".."]))
          (not (index-of (last part) [32 46]))
          (not (peg/match ~(* (choice "CON" "PRN" "AUX" "NUL" (* (choice "COM" "LPT") (range "19"))) (choice -1 "."))
            (string/ascii-upper part)))) "invalid path component")
        (set target (path/join target part))
        (assert (not= :link (os/lstat target :mode)) "filesystem links are not permitted")
        (when (index-of (os/which) [:windows :mingw])
          (def attrs (ffi/call (ffi/lookup (ffi/native "kernel32.dll") "GetFileAttributesA") (ffi/signature :default :uint32 :string) target))
          (assert (or (= attrs 0xffffffff) (= 0 (band attrs 0x400))) "filesystem reparse points are not permitted")))
      (case binding
        "fs/list" (do (assert (= :directory (os/stat target :mode)) "directory required") (sorted (os/dir target)))
        "fs/read" (do (assert (= :file (os/stat target :mode)) "regular file required")
          (with [f (file/open target :rbn)]
          (def bytes (or (file/read f (+ 1 (c :response-bytes))) ""))
          (assert (and (<= (length bytes) (c :response-bytes)) (utf8/is-valid? bytes)) "file is oversized or not UTF-8") (string bytes)))
        (do (assert (or (not (os/stat target)) (= :file (os/stat target :mode))) "regular file required")
          (assert (and (string? text) (utf8/is-valid? text) (<= (length text) (c :response-bytes))) "invalid file text")
          (spit target text :wb) nil)))
    (= binding "http/request")
    (let [[name method segments body] args grant (get-in c [:http (keyword name)])]
      (assert (and (= 4 (length args)) grant (index-of method (grant :methods))) "HTTP permission denied")
      (each segment segments (assert (and (string? segment) (not (index-of segment ["." ".."]))
        (peg/match ~(* (some (set "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-~.")) -1) segment)) "invalid HTTP segment"))
      (request c grant method (string/join segments "/") body))
    (= binding "process/run")
    (let [command (get-in c [:processes (keyword (first args))])]
      (assert (and (= 1 (length args)) command (path/abspath? ((command :argv) 0))) "process permission denied")
      (process (command :argv) (get command :env {}) (c :response-bytes) (c :seconds)))
    (error "unknown external binding")))

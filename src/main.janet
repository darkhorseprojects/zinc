(import pa)
(import spork/path :as path)
(import ./config)
(import ./store)
(import ./vm)
(import ./model)
(import ./memory)
(import ./effects)

(def directory (path/dirname (dyn :source)))
(def runtime (store/digest (string janet/version janet/build janet/config-bits
  (string/join (map |(slurp (path/join directory $)) ["main.janet" "config.janet" "store.janet" "store.sql" "vm.janet" "agent.janet" "model.janet" "memory.janet" "effects.janet"])))))
(defn configured [host profile &opt options]
  (def c (merge (get (host :profiles) (keyword (or profile (host :profile))))))
  (assert (c :handle) "unknown policy")
  (each [key value] (pairs (or options {}))
    (assert (find |(= (string key) ($ :name)) config/parameters) "unknown option")
    (case key :rounds (assert (and (int? value) (<= 1 value (c :rounds))) "round limit exceeds grant")
      :temporary (assert (boolean? value) "temporary must be boolean")
      :queue (assert (boolean? value) "queue must be boolean")
      (when (index-of key [:chat :thinking]) (assert (string? value) "option must be text")))
    (unless (index-of key [:path :from :memory]) (put c key value))) c)
(defn storage [host c &opt initialize]
  (def key (if (c :temporary) (string "ram:" (c :profile)) (c :store)))
  (or (get (host :stores) key)
    (let [source (when (c :temporary) (or (get (host :stores) (c :store))
          (when (os/stat (c :store)) (store/open (merge c {:temporary false}) false nil true))))
      s (store/open c initialize source)]
      (put s :frame-limit (host :limit)) (put (host :stores) key s) s)))
(defn notify [host s a kind fields]
  (array/push (host :notifications) {:type "event" :value (merge {:kind kind :stream (s :identity) :context (a :context)
    :work {:path (a :path) :request (a :request)}} fields)}))
(defn record [s h a kind text &opt presentation image outcome]
  (def output (when presentation (merge presentation)))
  (def run (h :run))
  (put s :config (a :policy))
  (when output (assert (< (+ 128 (length (config/encode {:type "event" :value {:kind "message" :stream (s :identity)
    :cursor 0 :context (a :context) :work {:path (h :id) :request (a :request)} :state (a :state) :output output}})))
    (s :frame-limit)) {:code "OutputLimit" :message "Output exceeds PA_FRAME_BYTES."}))
  (def changed (and image (run :dirty)))
  (def r (store/append s h {:kind kind :path (h :id) :request (a :request) :owner (a :owner) :author (a :author) :at (get a :at (if (= kind "input") (get-in a [:input :at] (os/clock)) (os/clock)))
    :text text :output output :outcome outcome :signature (a :signature) :context (a :context) :state (a :state) :world (run :world) :world-point (run :expected)
    :bindings (run :bindings-point)} (when changed image)))
  (put run :memory (memory/extend s r (run :memory) (a :policy)))
  (when changed (put run :dirty false) (put run :bindings-point (r :id)))
  (when output
    (put output :id (get output :id (string (r :id))))
    (when outcome (put output :footer (string "#" (a :start) " (↻" (a :index) ") → #" (r :id) " · "
      (if (= "error" (outcome :status)) "failed" (outcome :status)))))
    (store/replace s r)) r)
(defn finish [host s h result &opt packet]
  (var outcome result)
  (def run (h :run)) (def a (run :active)) (def c (a :policy))
  (def image (get packet :bindings (store/image s (run :bindings-point))))
  (def changed (run :changed))
  (unless (get packet :bindings) (put run :dirty false))
  (def world (store/world s (run :world)))
  (when (and changed (= "ok" (outcome :status)) (not= (run :expected) (world :point)))
    (set outcome {:status "error" :error {:code "WorldChanged" :message "World changed; local bindings retained, effects not repeated."}}))
  (def value (if (= "ok" (outcome :status)) (outcome :value) (outcome :error)))
  (def output (unless (and (= "ok" (outcome :status)) (run :final))
    {:type "response" :format (if (string? value) "markdown" "json") :text (if (string? value) value (config/encode value))}))
  (store/transact s
    (def r (record s h a (if output "message" "result") (get output :text "") output image outcome))
    (put (r :data) :terminal true) (store/replace s r)
    (when (and changed (= "ok" (outcome :status)))
      (put world :point (r :id)) (store/save s world)
      (put (r :data) :world-point (r :id)) (store/replace s r))
    (def queue (run :queue))
    (put h :run (when (not (empty? queue)) @{:queue queue})) (store/save s h))
  (notify host s a "busy" {:value false}))
(defn cancel [host s work author]
  (store/permit s (store/head s (work :path)) author)
  (def owned @{(work :request) true})
  (def active (store/pending s))
  (each a active
    (var cursor a)
    (while cursor
      (when (owned (cursor :request)) (put owned (a :request) true) (break))
      (def parent (cursor :owner))
      (set cursor (when parent (or (find |(= parent ($ :request)) active)
        (if (s :db) (get (first (store/query s "SELECT data FROM journal WHERE json_extract(data,'$.request')=? ORDER BY id LIMIT 1" [parent])) :data)
          (get (find |(= parent (get-in $ [:data :request])) (values (s :rows))) :data)))))))
  (def outcome {:status "cancelled" :error {:code "Cancelled" :message "Cancelled; dispatched effects are not undone."}})
  (store/transact s
    (each h (values (s :heads)) (when-let [run (h :run)]
      (def queued (filter |(owned ($ :request)) (run :queue)))
      (when (or (not (empty? queued)) (owned (get-in run [:active :request])))
        (put run :queue (filter |(not (owned ($ :request))) (run :queue)))
        (each a queued
          (unless (run :world)
            (def base (when (h :point) (store/row s (h :point))))
            (put run :world (get-in base [:data :world] (get-in a [:policy :world])))
            (put run :memory (get-in base [:data :memory] []))
            (put run :bindings-point (when base (if (base :image) (base :id) (get-in base [:data :bindings])))))
          (def text "Cancelled before execution.")
          (def r (record s h a "message" text {:type "response" :format "markdown" :text text}))
          (put (r :data) :outcome outcome) (put (r :data) :terminal true) (store/replace s r))
        (if (owned (get-in run [:active :request])) (finish host s h outcome)
          (do (when (and (not (run :active)) (empty? (run :queue))) (put h :run nil)) (store/save s h))))))) true)
(defn view [s point c]
  (def packet (vm/step {:view true :image (store/image s point) :config c :bindings (c :registry)}))
  (when (packet :failure) (error (packet :failure))) (packet :view))
(defn local [host s h a packet binding args]
  (def run (h :run)) (def c (a :policy))
  (case binding
    :exposure (let [selected (when (c :chat) (model/select c "chat"))]
      (merge (config/expose c (c :registry)) {:instructions (c :instructions-text)
        :capacity (math/floor (* (min (get selected :context 32768) (get c :context-quota math/inf)) (/ (c :context-percent) 100)))
        :settings (merge (get (config/expose c (c :registry)) :settings) {:score (c :score)})}))
    :memory-plan (memory/plan s (get run :memory []) c (args 0) (args 1))
    :memory-save (memory/save s (args 0) (args 1))
    :memory-summary (let [request (first args) roots (if (request :point)
        (get-in (store/row s (store/access s (request :point) (a :author))) [:data :memory]) (run :memory))]
      (assert (not (empty? roots)) "empty memory") (map |(memory/need s $ c) roots))
    :message (do (record s h a "message" (get-in args [0 :text]) (args 0) (packet :bindings)
      {:status (args 1)}) true)
    "world/view" (view s (store/access s (first args) (a :author)) c)
    "world/point" (h :point)
    "world/rewind" (do
      (assert (c :rewind) "world rewind not granted")
      (def point (store/access s (first args) (a :author)))
      (assert (index-of (get-in (store/row s point) [:data :world]) (c :worlds)) "world is not granted")
      (def world (store/world s (run :world)))
      (def r (record s h a "message" (string "World rewound to #" point)
        {:type "tool-result" :format "markdown" :text (string "World rewound to #" point)} nil {:status "ok"}))
      (put (r :data) :bindings (get-in (store/row s point) [:data :bindings] point))
      (when ((store/row s point) :image) (put (r :data) :bindings point)) (store/replace s r)
      (put world :point (r :id)) (store/save s world) (r :id))
    "self" (let [input (merge (first args))]
      (unless (or (input :path) (input :from)) (when (h :point) (put input :from (h :point))))
      (store/admit s input c (a :author) (a :context) a
        {:image (packet :bindings) :memory (run :memory) :world (run :world) :expected (run :expected)
         :dirty (run :dirty) :point (run :bindings-point)}))
    "self/result" (do (store/permit s (store/head s ((first args) :path)) (a :author)) (store/result s (first args)))
    "self/cancel" (cancel host s (first args) (a :author))
    "memory/expand" (memory/sources s (if (first args)
      (get-in (store/row s (store/access s (first args) (a :author))) [:data :memory]) (run :memory)))
    "memory/invalidate" (memory/invalidate s (first args) (run :memory))
    "time/now" (os/clock)
    "random/bytes" (do (assert (and (int? (first args)) (<= 1 (first args) 4096)) "invalid random byte count")
      (string/join (map |(string/format "%02x" $) (string/bytes (os/cryptorand (first args))))))
    (error (string "unknown runtime operation " binding))))
(defn commit-step [host s h packet]
  (def run (h :run)) (def a (run :active)) (def c (a :policy))
  (if (packet :failure) (finish host s h {:status "error" :error (packet :failure)})
    (store/transact s
      (when (packet :changed) (put run :changed true) (put run :dirty true))
      (put run :machine (packet :image)) (put run :reply nil) (put run :waits (packet :waits))
      (each [i call] (pairs (run :calls))
        (when (and call (call :result) (not (find |(= i ($ :call)) (packet :waits)))) (put (run :calls) i nil)))
      (when (> (length (packet :output)) 0)
        (record s h a "message" (packet :output) {:type "response" :format "markdown" :text (packet :output)} (packet :bindings)))
      (when-let [op (packet :operation)]
        (def binding (op :binding)) (def args (op :arguments))
        (cond
          (or (index-of binding [:chat :rerank]) (= "external" (get-in c [:registry binding :class])))
          (do
            (def index (length (run :calls)))
            (def arguments (if (index-of binding [:chat :rerank])
              [(merge (model/prepare c (first args) (= binding :rerank)) {:output (string (a :request) "/" index)})] args))
            (array/push (run :calls) @{:binding binding :arguments arguments :dispatched false})
            (unless (keyword? binding)
              (record s h a "message" (config/encode {:binding binding :arguments args})
                {:id (string (a :request) "/" index "/call") :type "tool-call" :format "json" :text (config/encode {:binding binding :arguments args})} (packet :bindings))))
          (= binding :await)
          (do
            (def work (first args)) (assert (and (dictionary? work) (string? (work :request))) "await expects a task or work reference")
            (def target (store/head s (work :path))) (store/permit s target (a :author))
            (assert (not= (a :request) (work :request)) "cannot await this inquiry")
            (if-let [result (store/result s work)] (put run :reply [(packet :task) result])
              (do
                (assert (find |(= (work :request) ($ :request)) (store/pending s)) "work reference unavailable")
                (def seen @{})
                (def reaches (fn reaches [at]
                  (cond (= (at :id) (h :id)) true (seen (at :id)) false
                    (do (put seen (at :id) true)
                      (or (some |(and (has-key? $ :request) (not (store/result s $)) (reaches (store/head s ($ :path))))
                          (get-in at [:run :waits] []))
                        (when-let [queued (first (get-in at [:run :queue]))]
                          (some |(and (queued :owner) (= (queued :owner) ($ :owner))
                            (get-in queued [:input :queue]) (get-in $ [:input :queue]) (< ($ :order) (queued :order))
                            (reaches (store/head s ($ :path)))) (store/pending s))))))))
                (assert (not (reaches target)) {:code "WaitCycle" :message "Wait would form a cycle."}))))
          (do
            (def result (try {:status "ok" :value (local host s h a packet binding args)}
              ([err fiber] {:status "error" :error (config/diagnostic err fiber)})))
            (put run :reply [(packet :task) result]))) )
      (when (packet :settled) (finish host s h (packet :settled) packet))
      (def op (packet :operation))
      (when (and (h :run) (or (not op) (> (length (packet :output)) 0)
        (index-of (op :binding) [:chat :rerank :message "self" "self/cancel" "world/rewind"])
        (= "external" (get-in c [:registry (op :binding) :class])))) (store/save s h)))))
(defn receipt [host s h index result]
  (def run (h :run)) (def a (run :active)) (def call ((run :calls) index))
  (unless (call :result)
    (store/transact s
      (put call :result result)
      (if (and (= :chat (call :binding)) (= "ok" (result :status)))
        (do
          (def outputs (filter |(not (index-of ($ :id) (get call :emitted []))) (get-in result [:value :outputs])))
          (when (and (empty? outputs) (not (get-in call [:arguments 0 :summary])))
            (array/push outputs {:id (string (get-in call [:arguments 0 :output]) "/boundary") :type "response" :format "markdown" :text ""}))
          (each [i output] (pairs outputs)
            (def last (= i (- (length outputs) 1)))
            (def r (record s h a "message" (output :text) output nil (when last {:status (get-in result [:value :stop])})))
            (when last
              (put (r :data) :model {:request (first (call :arguments)) :response (get-in result [:value :message])
                :stop (get-in result [:value :stop]) :usage (get-in result [:value :usage])}) (store/replace s r)))
          (when (and (not (get-in call [:arguments 0 :summary])) (index-of (get-in result [:value :stop]) ["answer" "refused"])) (put run :final true)))
        (unless (keyword? (call :binding))
          (record s h a "message" (config/encode result) {:id (string (a :request) "/" index "/result")
            :type "tool-result" :format "json" :text (config/encode result)} nil result)))
      (store/save s h))))
(defn start [host s h]
  (def run (h :run)) (def a (first (run :queue)))
  (array/remove (run :queue) 0) (put run :active a) (put run :calls @[])
  (def c (a :policy)) (def point (h :point)) (def base (when point (store/row s point)))
  (def name (get-in a [:seed :world] (get-in base [:data :world] (c :world))))
  (assert (index-of name (c :worlds)) "world is not granted")
  (def world (store/world s name))
  (def origin (or point (world :point)))
  (def image (or (get-in a [:seed :image]) (store/image s origin)))
  (put run :world name) (put run :expected (get-in a [:seed :expected] (get-in base [:data :world-point] (world :point))))
  (put run :changed false) (put run :dirty (get-in a [:seed :dirty] false))
  (put run :machine image) (put run :starting true)
  (put run :bindings-point (get-in a [:seed :point] (when origin (def original (store/row s origin))
    (if (original :image) origin (get-in original [:data :bindings])))))
  (put run :memory (if-let [selected (get-in a [:input :memory])]
    (get-in (store/row s (store/access s selected (a :author))) [:data :memory])
    (get-in a [:seed :memory] (get-in base [:data :memory] []))))
  (put a :seed nil)
  (store/transact s
    (each evidence (get-in a [:input :records] [])
      (record s h (merge a {:author (evidence :author) :at (evidence :at)}) "evidence" (evidence :text)))
    (def r (record s h a "input" (or (get-in a [:input :text]) (get-in a [:input :code])) nil image))
    (put (r :data) :input {:type (if (get-in a [:input :code]) "code" "text") :images (get-in a [:input :images] [])})
    (store/replace s r) (put a :start (r :id))
    (put a :index (if (s :db) ((first (store/query s "SELECT count(*) n FROM journal WHERE json_extract(data,'$.kind')='input'")) :n)
      (length (filter |(= "input" (get-in $ [:data :kind])) (values (s :rows))))))
    (store/save s h))
  (notify host s a "busy" {:value true}))
(defn dispatch [host s h index]
  (def run (h :run)) (def a (run :active)) (def c (a :policy)) (def call ((run :calls) index))
  (def key [(s :identity) (h :id) index])
  (unless (or (call :result) (get (host :effects) key))
    (if (call :dispatched)
      (receipt host s h index {:status "unknown" :error {:code "EffectOutcomeUnknown" :message "Dispatched call has no outcome; it was not repeated."}})
      (do
        (put call :dispatched true) (store/save s h) (put (host :effects) key true)
        (ev/go (fn []
          (def binding (call :binding))
          (def spec (if (keyword? binding) {} (get-in c [:registry binding])))
          (def result (try
            (let [value (if (get spec :import)
                (do (def id (store/nonce)) (def reply (ev/chan 1)) (put (host :pending) id reply)
                  (ev/give (host :outgoing) {:type "call" :id id :caller (host :handle) :context (a :context) :method binding :params (first (call :arguments))})
                  (defer (ev/chan-close reply) (def response (ev/take reply))
                    (when (response :error) (error (response :error))) (postwalk |(if (= $ :null) nil $) (response :value))))
                (let [reply (ev/thread-chan 64)]
                  (defer (ev/chan-close reply)
                    (ev/thread (fn [[c spec binding args reply]]
                      (def result (try {:value (with-dyns [:zinc/preview reply]
                        (effects/invoke c spec (case binding :chat "model/chat" :rerank "model/rerank" binding) args))}
                        ([err fiber] {:error (config/diagnostic err fiber)})))
                      (ev/give reply result)) [c spec binding (call :arguments) reply] :n)
                    (var packet (ev/take reply))
                    (while (or (packet :preview) (packet :complete))
                      (if (packet :preview) (when (= (a :request) (get-in h [:run :active :request]))
                        (notify host s a "delta" (packet :preview)) (ev/give (host :events) {:type "wake"}))
                        (when (= (a :request) (get-in h [:run :active :request]))
                          (store/transact s
                            (def output (packet :complete))
                            (record s h a "message" (output :text) output)
                            (def current (get-in h [:run :calls index]))
                            (put current :emitted (array/concat @[] (get current :emitted []) [(output :id)])) (store/save s h))
                          (ev/give (host :events) {:type "wake"})))
                      (set packet (ev/take reply)))
                    (when (packet :error) (error (packet :error))) (packet :value))))]
              (assert (<= (length (config/encode value)) (c :response-bytes)) "effect response limit") {:status "ok" :value value})
            ([err fiber] {:status (get-in err [:context :outcome] "unknown") :error (config/diagnostic err fiber)})))
          (ev/give (host :events) {:type "receipt" :store s :path (h :id) :request (a :request) :index index :result result})))))))
(defn schedule [host]
  (var pending false)
  (each s (values (host :stores))
    (each h (values (s :heads)) (when (h :run)
      (set pending true) (def key [(s :identity) (h :id)])
      (unless (get (host :active) key)
        (try (do
          (unless (get-in h [:run :active])
            (def a (first (get-in h [:run :queue])))
            (unless (find |(and (a :owner) (= (a :owner) ($ :owner)) (get-in a [:input :queue])
              (get-in $ [:input :queue]) (< ($ :order) (a :order))) (store/pending s)) (start host s h)))
          (when-let [a (get-in h [:run :active])]
            (def c (config/authorize (configured host (get-in a [:policy :profile])) (a :policy)))
            (put a :policy (merge c {:registry (config/registry c (get (host :imports) (keyword (c :profile)) {}))}))
            (when (and (a :deadline) (<= (a :deadline) (os/clock))) (error {:code "DeadlineExceeded" :message "Inquiry deadline expired."}))
            (def run (h :run))
            (each [i call] (pairs (run :calls)) (when (and call (< (length (host :effects)) (c :parallel))) (dispatch host s h i)))
            (def ready (or (run :starting) (run :reply) (not (run :waits))
              (some |(or (and (has-key? $ :call) (get-in run [:calls ($ :call) :result]))
                (and (has-key? $ :timer) (<= ($ :timer) (os/clock)))
                (and (has-key? $ :request) (store/result s $))) (run :waits))))
            (when (and ready (< (length (host :active)) (c :parallel)))
              (put (host :active) key true)
              (def args {:image (run :machine) :starting (run :starting) :input (a :input) :config (a :policy)
                :bindings (get-in a [:policy :registry]) :calls (run :calls) :reply (run :reply) :request (a :request) :now (os/clock)
                :results (tabseq [wait :in (get run :waits []) :when (has-key? wait :request) :let [r (store/result s wait)] :when r] (wait :request) r)})
              (put run :starting nil)
              (ev/go (fn [] (def reply (ev/thread-chan 1))
                (defer (ev/chan-close reply)
                  (ev/thread (fn [[args reply]] (ev/give reply (vm/step args))) [args reply] :n)
                  (ev/give (host :events) {:type "step" :store s :path (h :id) :request (a :request) :packet (ev/take reply)})))))))
          ([err fiber] (eprint (config/encode (config/diagnostic err fiber))) (when (get-in h [:run :active]) (finish host s h {:status "error" :error (config/diagnostic err fiber)})))))))
    (when (has-key? s :cursor)
      (def rows (if (s :db) (store/query s "SELECT * FROM journal WHERE id>? ORDER BY id" [(s :cursor)])
        (sorted (filter |(< ($ :id) (s :cursor)) (values (s :rows))) |(> ($0 :id) ($1 :id)))))
      (each r rows
        (when-let [output (get-in r [:data :output])]
          (def d (r :data))
          (def a (or (find |(= (d :request) ($ :request)) (store/pending s)) {:request (d :request) :path (d :path) :context (d :context)}))
          (notify host s a "message" {:cursor (r :id) :output output :state (d :state)}))
        (put s :cursor (r :id))))) pending)
(defn application [host call]
  (def params (postwalk |(if (= $ :null) nil $) (call :params)))
  (assert (dictionary? params) "application arguments must be an object")
  (def caller (call :caller)) (def method (call :method))
  (when (= method "app/open")
    (assert (= caller (host :handle)) "only owner configures application")
    (def settings (params :settings)) (put host :imports (settings :imports))
    (each [name supplied] (pairs (settings :profiles))
      (def c (config/parse supplied (host :handle) (string name) runtime))
      (put c :catalogue (effects/catalogue c))
      (put c :registry (config/registry c (get (host :imports) name {}))) (put c :granted (keys (c :registry)))
      (put c :instructions-text (slurp (c :instructions))) (put (host :profiles) name c)
      (when (or (params :initialize) (c :temporary) (os/stat (c :store))) (storage host c (params :initialize))))
    (put host :profile (settings :profile))
    (break {:profiles (tabseq [[name c] :pairs (host :profiles)] name
      {:parameters (map |(merge $ {:default (get c (keyword ($ :name)) "automatic")}) config/parameters)
       :commands (filter |(or (= "models" ($ :name)) (c :inspect)) config/commands) :history (c :history-records) :inputs (c :accept)})}))
  (def c (configured host (params :profile) (params :options)))
  (when (params :work) (put c :temporary (< (get-in params [:work :path]) 0)))
  (def s (storage host c)) (put s :config c)
  (def state (merge (get params :state {})))
  (def navigation (if (c :temporary) :temporary-path :path))
  (case method
    "app/submit" (let [input (merge (params :input)) options (get params :options {})]
      (assert (index-of (if (input :code) "code" "text") (c :accept)) "input kind is not granted")
      (merge-into input (tabseq [k :in [:queue :path :from :memory] :when (has-key? options k)] k (options k)))
      (unless (or (input :path) (input :from))
        (when-let [p (or (state navigation) (when (c :temporary) (state :path)))] (put input :path p)))
      (when (params :request) (put input :request (params :request)))
      (store/transact s (def work (store/admit s input c caller (params :context) nil nil state))
        (put state navigation (work :path)) {:work work :state state}))
    "app/read" (do (store/permit s (store/head s (get-in params [:work :path])) caller)
      (when (params :wait) (while (not (store/result s (params :work))) (ev/sleep 0.05))) (store/result s (params :work)))
    "app/cancel" (cancel host s (params :work) caller)
    "app/observe" (do (assert (= caller (host :handle)) "only owner observes output")
      (each s (values (host :stores))
        (def cursor (if (has-key? params :cursors) (get (params :cursors) (keyword (s :identity)) 0)
          (if (s :db) ((first (store/query s "SELECT coalesce(max(id),0) n FROM journal")) :n) (s :next-row))))
        (when (and (has-key? params :cursors) (not= 0 cursor))
          (assert (get-in (store/row s cursor) [:data :output]) "cursor is not an output position"))
        (put s :cursor cursor)
        (each h (values (s :heads)) (when-let [a (get-in h [:run :active])] (notify host s a "busy" {:value true})))) true)
    "app/append" (let [h (store/head s (state navigation))]
      (store/access s (h :point) caller) (assert (not (h :run)) "path is busy")
      (assert (<= (length (params :records)) (c :history-records)) "evidence batch limit")
      (put h :run @{:memory (get-in (store/row s (h :point)) [:data :memory]) :world (c :world)})
      (store/transact s (each evidence (params :records)
        (record s h {:request (store/nonce) :author caller :at (evidence :at) :policy c} "evidence" (evidence :text)))
        (put h :run nil) (store/save s h)) {:state state})
    "app/command" (let [command (params :command) args (get params :arguments {})]
      (if (= command "models")
        (let [models (filter |(and (= (get args :role "chat") ($ :role))
          (or (not (args :query)) (string/find (string/ascii-lower (args :query)) (string/ascii-lower ($ :ref))))) (c :catalogue))]
          (if (params :completion) {:choices (map |{:name ($ :ref) :value ($ :ref)} (take 25 models))} {:value models}))
        (do (assert (c :inspect) "inspection not granted")
          (def path (or (get-in params [:options :path]) (state navigation) (when (c :temporary) (state :path))))
          (def selected (if path ((store/permit s (store/head (if (and (c :temporary) (> path 0)) (s :source) s) path) caller) :point)
            ((store/world s (c :world)) :point)))
          (def requested (or (args :reference) (when (= command "memory-expand") (get-in params [:options :memory])) (get-in params [:options :from])))
          (when (and (not selected) (not requested) (= command "world-view")) (break {:value (view s nil c) :format "code" :language "clojure"}))
          (def point (store/nearest s selected requested caller))
          (case command
            "world-point" {:value point}
            "world-view" {:value (view s point c) :format "code" :language "clojure" :footer (string "point #" point)}
            "world-inspect" {:value (merge ((store/row s point) :data) {:point point})}
            "memory-expand" {:value (memory/sources s (get-in (store/row s point) [:data :memory]))}
            (error "unknown command")))))
    (error "unknown application method")))
(defn main []
  (unless (index-of (os/which) [:windows :mingw]) (os/umask 8r077) (os/sigaction :pipe (fn [])))
  (def limit (scan-number (os/getenv "PA_FRAME_BYTES"))) (def handle (os/getenv "PA_HANDLE"))
  (assert (and (int? limit) (> limit 0) (string? handle)) "PA_FRAME_BYTES and PA_HANDLE required")
  (def incoming (ev/thread-chan 256)) (def outgoing (ev/thread-chan 256)) (def events (ev/chan 256))
  (def host @{:handle handle :limit limit :events events :outgoing outgoing :stores @{} :profiles @{} :active @{} :effects @{} :pending @{} :notifications @[]})
  (ev/thread (fn [[incoming limit]] (try (do (def buffer @"") (var message nil)
    (while (set message (pa/read stdin buffer limit)) (ev/give incoming message)) (os/exit 0 true))
    ([err] (eprint (config/encode (config/diagnostic err))) (os/exit 1 true)))) [incoming limit] :n)
  (ev/thread (fn [[outgoing limit]] (try (while true (pa/write stdout (ev/take outgoing) limit))
    ([err] (eprint (config/encode (config/diagnostic err))) (os/exit 1 true)))) [outgoing limit] :n)
  (ev/give outgoing {:type "ready" :handle handle})
  (while true
    (def [_ _ message] (ev/select incoming events))
    (case (message :type)
      "call" (ev/go (fn []
        (ev/give outgoing (try (let [value (application host message) result {:type "result" :id (message :id) :value (if (nil? value) :null value)}]
          (assert (< (length (config/encode result)) limit) {:code "ResponseLimit" :message "Response exceeds PA_FRAME_BYTES."}) result)
          ([err fiber] {:type "error" :id (message :id) :error (config/diagnostic err fiber)})))
        (ev/give events {:type "wake"})))
      "step" (let [s (message :store) h (store/head s (message :path))]
        (put (host :active) [(s :identity) (h :id)] nil)
        (when (= (message :request) (get-in h [:run :active :request]))
          (try (commit-step host s h (message :packet))
            ([err fiber] (finish host s h {:status "error" :error (config/diagnostic err fiber)})))))
      "receipt" (let [s (message :store) h (store/head s (message :path))]
        (put (host :effects) [(s :identity) (h :id) (message :index)] nil)
        (when (= (message :request) (get-in h [:run :active :request])) (receipt host s h (message :index) (message :result))))
      "tick" (put host :timer nil)
      "wake" nil
      (let [reply (get (host :pending) (message :id))]
        (assert reply "unexpected response") (put (host :pending) (message :id) nil) (ev/give reply message)))
    (when (and (schedule host) (not (host :timer))) (put host :timer true)
      (ev/go (fn [] (ev/sleep 0.05) (ev/give events {:type "tick"}))))
    (while (not (empty? (host :notifications)))
      (ev/give outgoing (first (host :notifications))) (array/remove (host :notifications) 0))
    (each s (values (host :stores))
      (when (s :db) (table/clear (s :rows)))
      (when (get-in s [:source :db]) (table/clear (get-in s [:source :rows]))))))

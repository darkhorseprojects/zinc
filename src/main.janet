(import pa)
(import spork/path :as path)
(import spork/base64 :as base64)
(import spork/json :as json)
(import ./config)
(import ./store)
(import ./vm)
(import ./model)
(import ./memory)
(import ./effects)

(def directory (path/dirname (dyn :source)))
(def runtime (store/digest (string janet/version janet/build janet/config-bits (slurp (path/join directory "../project.janet"))
  (string/join (map |(slurp (path/join directory $)) ["main.janet" "config.janet" "store.janet" "store.sql" "vm.janet" "agent.janet" "model.janet" "memory.janet" "effects.janet"])))))
(defn storage [host c]
  (def key (if (c :temporary) (string "ram:" (c :store) ":" (get c :request (store/nonce))) (c :store)))
  (or (get (host :stores) key)
    (let [source (when (c :temporary) (or (get (host :stores) (c :store))
            (when (os/stat (c :store)) (store/open (merge c {:temporary false}) false nil true))))
          s (store/open c (c :initialize) source)]
      (put (host :stores) key s) s)))
(defn rows [s after]
  (if (s :db) (store/query s "SELECT * FROM journal WHERE id>? ORDER BY id" [after])
    (sorted (filter |(< ($ :id) after) (values (s :rows))) |(> ($0 :id) ($1 :id)))))
(defn selected [host s c &opt reading]
  (put s :config c)
  (def key [(s :identity) (c :world) (c :conversation)])
  (def previous (or (get (host :conversations) key)
    (when (s :db) (get-in (first (store/query s
      "SELECT data FROM journal WHERE json_extract(data,'$.conversation')=? AND json_extract(data,'$.world')=? ORDER BY id DESC LIMIT 1" [(c :conversation) (c :world)])) [:data :path]))))
  (cond (c :from) (if reading {:point (store/access s (c :from))} (store/create s nil (store/access s (c :from))))
    (or (c :path) previous) (do (unless (c :path) (put (host :conversations) key previous))
      (if (and (s :source) (c :path) (> (c :path) 0))
        (store/create s nil ((store/permit s (store/head (s :source) (c :path))) :point))
        (store/permit s (store/head s (or (c :path) previous)))))
    reading (store/world s (c :world))
    (let [h (store/create s nil ((store/world s (c :world)) :point))]
      (put (host :conversations) key (h :id)) h)))
(defn record [s h a data &opt image]
  (def run (h :run)) (def c (a :policy)) (put s :config c)
  (def changed (and image (run :dirty)))
  (def r (store/append s h (merge {:request (a :request) :path (h :id) :world (run :world)
    :bindings (run :bindings-point) :world-point (run :expected) :author (c :handle) :at (os/clock)} data) (when changed image)))
  (put run :memory (memory/extend s r (run :memory) c))
  (when changed (put run :dirty false) (put run :bindings-point (r :id)))
  (when (index-of (get-in r [:data :presentation :type]) ["tool-call" "tool-result"])
    (put (r :data) :presentation (merge (get-in r [:data :presentation])
      {:footer (string "#" (a :start) " (↻" (a :index) ") → #" (r :id) " · "
        (if (= "tool-call" (get-in r [:data :presentation :type])) "call" (get-in data [:outcome :status] "ok")))}))
    (store/replace s r)) r)
(defn update [run r]
  (unless (run :updates) (put run :updates @[]))
  (array/push (run :updates) {:id (r :id) :text (store/text r)}))
(defn finish [host s h outcome &opt packet]
  (def run (h :run)) (def a (run :active)) (def c (a :policy)) (put s :config c)
  (store/transact s
    (if (a :maintenance) (put (host :results) (a :request) outcome)
      (do
        (def world (store/world s (run :world)))
        (def conflict (and (= "ok" (outcome :status)) (run :changed) (not= (run :expected) (world :point))))
        (def result (if conflict {:status "error" :error {:code "WorldChanged"
          :message "World publication conflicted. Candidate bindings are retained; effects were not repeated."}} outcome))
        (def existing (when (and (= "ok" (result :status)) (run :answer)) (store/row s (run :answer))))
        (def r (or existing (record s h a {:kind "result" :outcome result
          :presentation {:type "tool-result" :id (string (a :request) "/result")
            :reply (string (a :request) "/script")}} (get packet :bindings))))
        (when (and existing (run :dirty) (packet :bindings))
          (put r :image (packet :bindings)) (put run :bindings-point (r :id)))
        (merge-into (r :data) {:terminal true :outcome (if existing {:status (result :status)} result)
          :bindings (run :bindings-point)})
        (put (r :data) :presentation (merge (get-in r [:data :presentation])
          {:footer (string "#" (a :start) " (↻" (a :index) ") → #" (r :id) " · " (result :status))}))
        (store/replace s r)
        (when (a :owner)
          (when-let [parent (find |(= (a :owner) (get-in $ [:run :active :request])) (values (s :heads)))]
            (def parent-run (parent :run)) (def policy (get-in parent-run [:active :policy]))
            (put parent-run :memory (memory/extend s r (parent-run :memory) policy true)) (update parent-run r)
            (put s :config policy) (store/save s parent) (put s :config c)))
        (when (and (run :changed) (= "ok" (result :status)))
          (put (r :data) :world-point (r :id)) (store/replace s r)
          (put world :point (r :id)) (store/save s world))))
    (def queue (run :queue))
    (put (host :owners) [(s :identity) (a :request)] nil)
    (put h :run (when (not (empty? queue)) @{:queue queue})) (store/save s h)))
(defn cancel [host s work]
  (store/permit s (store/head s (work :path)))
  (def owned @{(work :request) true})
  (each a (sorted (store/pending s) |(< ($0 :depth) ($1 :depth)))
    (when (owned (a :owner)) (put owned (a :request) true)))
  (store/transact s
    (each h (values (s :heads)) (when-let [run (h :run)]
      (def removed (filter |(owned ($ :request)) (get run :queue [])))
      (put run :queue (filter |(not (owned ($ :request))) (get run :queue [])))
      (each a removed
        (put s :config (a :policy))
        (def previous (when (h :point) (store/row s (h :point))))
        (def r (store/append s h {:kind "result" :request (a :request) :path (h :id)
          :world (get-in previous [:data :world] (get-in a [:policy :world]))
          :bindings (when previous (if (previous :image) (previous :id) (get-in previous [:data :bindings])))
          :world-point (get-in previous [:data :world-point]) :author (get-in a [:policy :handle]) :at (os/clock)
          :terminal true :outcome {:status "cancelled" :error {:code "Cancelled" :message "Cancelled before execution."}}}))
        (def roots (memory/extend s r (get-in previous [:data :memory] []) (a :policy)))
        (when (run :active) (put run :memory roots))
        (when (a :owner)
          (when-let [parent (find |(= (a :owner) (get-in $ [:run :active :request])) (values (s :heads)))]
            (def parent-run (parent :run)) (def policy (get-in parent-run [:active :policy]))
            (put parent-run :memory (memory/extend s r (parent-run :memory) policy true)) (update parent-run r)
            (put s :config policy) (store/save s parent) (put s :config (a :policy)))))
      (if (owned (get-in run [:active :request]))
        (finish host s h {:status "cancelled" :error {:code "Cancelled" :message "Cancelled; dispatched actions are not undone."}})
        (do (when (and (not (run :active)) (empty? (run :queue))) (put h :run nil)) (store/save s h)))))) true)
(defn view [s point c]
  (def packet (vm/step {:view true :image (store/image s point) :config c}))
  (when (packet :failure) (error (packet :failure))) (packet :view))
(defn local [host s h a packet binding args]
  (def run (h :run)) (def c (a :policy))
  (case binding
    :exposure (let [selected (model/select c "chat") window (min (selected :context) (get c :context-quota math/inf))]
      (merge (config/expose c (packet :role)) {:instructions (c :instructions-text) :window window
        :memory (math/floor (* window (/ (c :context-percent) 100))) :reserve (min (get c :output 4096) (get selected :output 4096))}))
    :memory-plan (memory/plan s (get run :memory []) c (args 0) (args 1) (args 2))
    :memory-select (memory/finish s (args 0) (args 1) c)
    :memory-save (memory/save s (args 0) (args 1) c (run :memory))
    :memory-summary (let [request (first args) point (request :point)
      roots (if point (get-in (store/row s (store/access s point)) [:data :memory]) (run :memory))]
      (assert (not (empty? roots)) "empty memory")
      (def refs (if (request :node) [(memory/allowed s (request :node) roots)] roots))
      (map |(memory/need s $ c (get-in c [:summary :max-bytes])) refs))
    "world/view" (view s (store/access s (first args)) c)
    "world/point" (h :point)
    "world/rewind" (do
      (assert (c :rewind) "world rewind not granted")
      (def point (store/access s (first args)))
      (def world (store/world s (run :world)))
      (assert (= (run :expected) (world :point)) "world publication conflict")
      (def target (store/row s point))
      (def r (record s h a {:kind "result" :text (string "World rewound to #" point)
        :bindings (if (target :image) point (get-in target [:data :bindings]))}))
      (put world :point (r :id)) (store/save s world) (r :id))
    "self" (let [input (merge (first args))]
      (unless (or (input :path) (input :from)) (when (h :point) (put input :from (h :point))))
      (def child-config (merge c {:role (packet :role) :operation "submit"}))
      (def work (store/admit s input child-config (a :author) a
        {:image (packet :bindings) :memory (run :memory) :world (run :world) :expected (run :expected)
         :dirty (run :dirty) :point (run :bindings-point)}))
      (put (host :owners) [(s :identity) (work :request)] (get (host :owners) [(s :identity) (a :request)])) work)
    "self/result" (do (store/permit s (store/head s ((first args) :path))) (store/result s (first args)))
    "self/cancel" (cancel host s (first args))
    "memory/expand" (let [ref (first args)]
      (if (indexed? ref) (do (memory/allowed s ref (run :memory)) {:node ref :children (tabseq [key :in [:left :right]] key (get (memory/node s ref) key)) :text (memory/render s ref)})
        (memory/sources s (if ref (get-in (store/row s (store/access s ref)) [:data :memory]) (run :memory)))))
    "memory/invalidate" (memory/invalidate s (first args) (run :memory))
    "time/now" (os/clock)
    "random/bytes" (do (assert (and (int? (first args)) (<= 1 (first args) 4096)) "invalid random byte count")
      (string/join (map |(string/format "%02x" $) (string/bytes (os/cryptorand (first args))))))
    (error (string "unknown runtime operation " binding))))
(defn item [s h index response]
  (def run (h :run)) (def a (run :active)) (def call ((run :calls) index))
  (unless (call :seen) (put call :seen @{}))
  (each output (response :outputs) (unless (get (call :seen) (output :id))
    (def r (record s h a {:kind "message" :text (output :text)
      :presentation (tabseq [[key value] :pairs output :unless (= key :text)] key value)}))
    (put (call :seen) (output :id) (r :id))
    (when (= "tool-call" (output :type))
      (def position (index-of output (response :outputs)))
      (def number (length (filter |(= "tool-call" ($ :type)) (tuple/slice (response :outputs) 0 position))))
      (def script ((response :calls) number))
      (when (script :error)
        (eprint (config/encode (script :error)))
        (def failed (record s h a {:kind "result" :outcome {:status "error" :error (script :error)}
          :presentation {:type "tool-result" :reply (output :id) :id (string (output :id) "/rejected")}}))
        (put (call :seen) (string (output :id) "/rejected") (failed :id)))
      (unless (run :items) (put run :items @[]))
      (array/push (run :items) {:model (get-in call [:arguments 0 :output]) :call script :output (output :id)}))))
  (unless (call :native) (put call :native @[]))
  (each native (get-in response [:message :replay :items] [])
    (unless (find |(= (get $ :id) (get native :id)) (call :native)) (array/push (call :native) native))))
(defn receipt [host s h index outcome]
  (def run (h :run)) (def a (run :active)) (def call ((run :calls) index)) (put s :config (a :policy))
  (unless (call :result)
    (def result (merge outcome))
    (store/transact s
      (when (and (= :chat (call :binding)) (not (get-in call [:arguments 0 :summary])))
        (if (= "ok" (result :status))
          (do (item s h index (result :value))
            (put result :value (merge (result :value) {:message (merge (get-in result [:value :message]) {:sources (values (call :seen))})}))
            (when (index-of (get-in result [:value :stop]) ["answer" "refused"])
              (def last-output (last (filter |(= "response" ($ :type)) (get-in result [:value :outputs]))))
              (when last-output (put run :answer (get (call :seen) (last-output :id))))))
          (do
            (eprint (config/encode result))
            (def partial (if (= "responses" (get-in call [:arguments 0 :selected :protocol]))
              (model/decode (first (call :arguments)) {:status "incomplete" :output (get call :native [])})
              {:calls [] :output (get-in call [:arguments 0 :output]) :message {:role "assistant" :parts []}}))
            (put result :value (merge partial {:stop "interrupted"
              :message (merge (partial :message) {:sources (values (get call :seen {}))})})))))
      (when (and (keyword? (call :binding)) (not= "ok" (result :status)) (not (get-in call [:arguments 0 :summary])))
        (def r (record s h a {:kind "result" :outcome (tabseq [key :in [:status :error]] key (result key))
          :presentation {:type "tool-result" :id (string (a :request) "/" index "/failure")}})) (update run r))
      (put call :result result)
      (unless (keyword? (call :binding))
        (def r (record s h a {:kind "result" :outcome result
          :presentation {:type "tool-result" :id (string (a :request) "/" index "/result") :reply (string (a :request) "/" index "/call")}}))
        (update run r))
      (store/save s h))))
(defn start [host s h]
  (def run (h :run)) (def a (first (run :queue))) (def c (a :policy)) (put s :config c)
  (array/remove (run :queue) 0) (put run :active a) (put run :calls @[])
  (def base (when (h :point) (store/row s (h :point))))
  (def name (get-in a [:seed :world] (get-in base [:data :world] (c :world))))
  (assert (index-of name (c :worlds)) "world not granted")
  (def world (store/world s name)) (def origin (or (h :point) (world :point)))
  (put run :world name) (put run :expected (get-in a [:seed :expected] (get-in base [:data :world-point] (world :point))))
  (put run :machine (or (get-in a [:seed :image]) (store/image s origin)))
  (put run :dirty (get-in a [:seed :dirty] false)) (put run :changed (run :dirty))
  (put run :bindings-point (get-in a [:seed :point] (when origin (def original (store/row s origin))
    (if (original :image) origin (get-in original [:data :bindings])))))
  (put run :memory (if-let [point (get-in a [:input :memory])]
    (get-in (store/row s (store/access s point)) [:data :memory])
    (get-in a [:seed :memory] (get-in base [:data :memory] []))))
  (put a :seed nil)
  (unless (= "submit" (c :operation)) (put a :maintenance true))
  (store/transact s
    (unless (a :maintenance)
      (def r (record s h a {:kind "input" :text (or (get-in a [:input :text]) (get-in a [:input :code]))
        :author (a :author) :at (get-in a [:input :at] (os/clock)) :source (when (get-in a [:input :source]) (merge (get-in a [:input :source]) {:conversation (c :conversation)}))
        :conversation (when (= (h :id) (get (host :conversations) [(s :identity) (c :world) (c :conversation)])) (c :conversation)) :signature (a :signature)
        :admission {:policy (tabseq [[key value] :pairs c :unless (index-of key [:registry :role])] key value)
          :owner (a :owner) :depth (a :depth)}
        :input {:type (if (get-in a [:input :code]) "code" "text") :images (get-in a [:input :images] [])}}))
      (put a :start (r :id)) (put-in a [:input :source] (r :id))
      (put a :index (if (s :db) ((first (store/query s "SELECT count(*) n FROM journal WHERE json_extract(data,'$.kind')='input'")) :n)
        (length (filter |(= "input" (get-in $ [:data :kind])) (values (s :rows))))))
      (when (get-in a [:input :code])
        (put-in r [:data :presentation] {:type "tool-call" :id (string (a :request) "/script") :language "clojure"}) (store/replace s r)))
    (store/save s h)))
(defn commit-step [host s h packet counts]
  (def run (h :run)) (def a (run :active)) (def c (a :policy)) (put s :config c)
  (if (packet :failure) (finish host s h {:status "error" :error (packet :failure)})
    (store/transact s
      (put run :machine (packet :image)) (put run :waits (packet :waits)) (put run :reply nil)
      (each [i call] (pairs (run :calls))
        (when (and call (call :result) (not (find |(= i ($ :call)) (packet :waits)))) (put (run :calls) i nil)))
      (when (packet :changed) (put run :dirty true) (put run :changed true))
      (each [key count] (pairs counts) (repeat count (array/remove (run key) 0)))
      (each complete (packet :completed)
        (def r (record s h a {:kind "result" :outcome (complete :outcome)
          :presentation {:type "tool-result" :id (string (a :request) "/task/" (complete :task)) :reply (complete :script)}} (packet :bindings))) (update run r))
      (when-let [op (packet :operation)]
        (def binding (op :binding)) (def args (op :arguments))
        (cond
          (or (index-of binding [:chat :rerank]) (= "external" (get-in c [:registry (packet :role) binding :class])))
          (do
            (def index (length (run :calls)))
            (def arguments (if (index-of binding [:chat :rerank])
              [(merge (model/prepare c (first args) (= binding :rerank)) {:output (string (a :request) "/" index)})] args))
            (array/push (run :calls) @{:binding binding :role (packet :role) :arguments arguments})
            (unless (keyword? binding)
              (record s h a {:kind "message" :text (string "(" binding (if (empty? args) "" " ") (string/join (map |(string/format "%j" $) args) " ") ")")
                :presentation {:type "tool-call" :language "clojure" :id (string (a :request) "/" index "/call")}} (packet :bindings))))
          (= binding :await)
          (do (def work (first args)) (store/permit s (store/head s (work :path)))
            (assert (not= (a :request) (work :request)) "cannot await own inquiry")
            (if-let [result (store/result s work)] (put run :reply [(packet :task) result])
              (do (assert (find |(= (work :request) ($ :request)) (store/pending s)) "work unavailable")
                (assert (not (store/reaches? s (work :path) (h :id))) "cyclic work wait"))))
          (put run :reply [(packet :task) (try {:status "ok" :value (local host s h a packet binding args)}
            ([err fiber] {:status "error" :error (config/diagnostic err fiber)}))])))
      (if (packet :settled) (finish host s h (packet :settled) packet) (store/save s h)))))
(defn dispatch [host s h index authority]
  (def run (h :run)) (def a (run :active)) (def call ((run :calls) index)) (def c (a :policy))
  (def key [(s :identity) (a :request) index]) (def binding (call :binding))
  (def spec (if (keyword? binding) {} (get-in c [:registry (call :role) binding])))
  (def imported (when (and (spec :import) (authority :open)) (module/value (authority :imports) (symbol binding))))
  (def prepared (when (= binding :chat) (first (call :arguments))))
  (def summary-key (when (get prepared :summary) [(prepared :node) (prepared :recipe) (prepared :quota)]))
  (unless (s :summary-work) (put s :summary-work @{}))
  (def job (when summary-key (let [job (get (s :summary-work) summary-key)] (unless (get job :cancelled) job))))
  (var joined false)
  (when (and job (not (call :result)) (not (call :dispatched)))
    (if (job :result) (receipt host s h index (job :result))
      (do (put call :dispatched true) (store/save s h) (put (host :effects) key true)
        (array/push (job :waiters) {:path (h :id) :request (a :request) :index index})))
    (set joined true))
  (unless (or joined (call :result) (get (host :effects) key) (and (spec :import) (not imported) (not (call :dispatched))))
    (if (call :dispatched)
      (receipt host s h index {:status "unknown" :error {:code "EffectOutcomeUnknown" :message "Dispatched without an outcome; not repeated."}})
      (do
        (def cancel (when summary-key (ev/thread-chan 1)))
        (when summary-key (put (s :summary-work) summary-key @{:node (prepared :node) :origin [(a :request) index] :cancel cancel :waiters @[]}))
        (put call :dispatched true) (store/save s h) (put (host :effects) key true)
        (ev/go (fn []
          (def result (try
            (let [value (if imported (imported (first (call :arguments)))
                (let [reply (ev/thread-chan 1)]
                  (defer (ev/chan-close reply)
                    (ev/thread (fn [[c spec binding args events identity path request index reply cancel]]
                      (def owner (fiber/root))
                      (def watcher (when cancel (ev/go (fn []
                        (try (do (ev/take cancel) (ev/cancel owner {:code "SummaryInvalidated" :message "Summary work invalidated."}))
                          ([err] (unless (= err :finished) (error err))))))))
                      (def value (try {:status "ok" :value
                        (effects/invoke c spec (case binding :chat "model/chat" :rerank "model/rerank" binding) args
                          (fn [item]
                            (def ack (ev/thread-chan 1))
                            (defer (ev/chan-close ack)
                              (ev/give events {:type "item" :identity identity :path path :request request :index index :item item :ack ack})
                              (ev/take ack))))}
                        ([err fiber] {:status (get-in err [:context :outcome] "unknown") :error (config/diagnostic err fiber)})))
                      (when watcher (ev/cancel watcher :finished))
                      (ev/give reply value))
                      [(merge c (get-in c [:vm (call :role)])) spec binding (call :arguments)
                       (host :events) (s :identity) (h :id) (a :request) index reply cancel] :n)
                    (def value (ev/take reply)) (unless (= "ok" (value :status)) (error (merge (value :error) {:context {:outcome (value :status)}})))
                    (value :value))))]
              (assert (<= (length (config/encode value)) (c :response-bytes)) "effect response limit")
              {:status "ok" :value (if (nil? value) :null value)})
            ([err fiber] {:status (get-in err [:context :outcome] "unknown") :error (config/diagnostic err fiber)})))
          (ev/give (host :events) {:type "receipt" :identity (s :identity) :path (h :id) :request (a :request) :index index :result result
            :binding binding :policy c :world (run :world)})))))))
(defn schedule [host]
  (each s (values (host :stores))
    (each h (values (s :heads)) (when (h :run)
      (def key [(s :identity) (h :id)])
      (unless (get (host :active) key)
        (def a (or (get-in h [:run :active]) (first (get-in h [:run :queue]))))
        (def owner (get (host :owners) [(s :identity) (a :request)]))
        (def authority (find (fn [attachment]
          (and (= s (attachment :store)) (try (do (config/authorize (attachment :config) (a :policy)) true) ([err] false))))
          (if (get owner :open) [owner]
            (sorted (values (host :attachments)) |(and ($0 :open) (not ($1 :open)))))))
        (when authority
          (put (host :owners) [(s :identity) (a :request)] authority)
          (try (do
            (put a :policy (config/authorize (authority :config) (a :policy)))
            (put s :config (a :policy))
            (unless (get-in h [:run :active])
              (unless (find |(and (a :owner) (= (a :owner) ($ :owner)) (get-in a [:input :queue])
                (get-in $ [:input :queue]) (< ($ :order) (a :order))) (store/pending s)) (start host s h)))
            (when (get-in h [:run :active])
              (def run (h :run)) (def c (a :policy))
              (when (and (a :deadline) (<= (a :deadline) (os/clock))) (error {:code "DeadlineExceeded" :message "Inquiry deadline expired."}))
              (each [i call] (pairs (run :calls)) (when (and call (< (length (host :effects)) (c :parallel))) (dispatch host s h i authority)))
              (def ready (or (run :reply) (not (run :waits)) (not (empty? (get run :items []))) (not (empty? (get run :updates [])))
                (some |(or (and (has-key? $ :call) (get-in run [:calls ($ :call) :result]))
                  (and (has-key? $ :timer) (<= ($ :timer) (os/clock)))
                  (and (has-key? $ :request) (store/result s $))) (run :waits))))
              (when (and ready (< (length (host :active)) (c :parallel)))
                (put (host :active) key true)
                (def counts {:items (length (get run :items [])) :updates (length (get run :updates []))})
                (def args {:image (run :machine) :input (a :input) :config c :request (a :request) :calls (run :calls)
                  :reply (run :reply) :now (os/clock) :items (get run :items []) :updates (get run :updates [])
                  :children (some |(= (a :request) ($ :owner)) (store/pending s))
                  :results (tabseq [wait :in (get run :waits []) :when (has-key? wait :request) :let [r (store/result s wait)] :when r] (wait :request) r)})
                (ev/go (fn [] (def reply (ev/thread-chan 1))
                  (defer (ev/chan-close reply)
                    (ev/thread (fn [[args reply]] (ev/give reply (vm/step args))) [args reply] :n)
                    (ev/give (host :events) {:type "step" :identity (s :identity) :path (h :id) :request (a :request) :counts counts :packet (ev/take reply)})))))))
            ([err fiber] (eprint (config/encode (config/diagnostic err fiber)))
              (when (get-in h [:run :active]) (finish host s h {:status "error" :error (config/diagnostic err fiber)}))))))))))
(defn append-evidence [host s c records]
  (assert (and (indexed? records) (<= (length records) (c :history-records))) "evidence batch limit")
  (store/transact s
    (def h (selected host s c)) (def seen @{}) (var point (h :point))
    (while point (def r (store/row s point))
      (when (get-in r [:data :source :key]) (put seen (get-in r [:data :source :key]) true))
      (set point (r :previous)))
    (each source records
      (assert (and (dictionary? source) (string? (source :key)) (string? (source :author)) (source :at)
        (string? (source :text)) (<= 1 (length (source :text)) (c :source-bytes))) "invalid evidence")
      (unless (seen (source :key))
        (put seen (source :key) true)
        (def base (when (h :point) (store/row s (h :point))))
        (def roots (get-in h [:run :memory] (get-in base [:data :memory] [])))
        (def r (store/append s h {:kind "evidence" :world (get-in base [:data :world] (c :world))
          :path (h :id) :conversation (when (= (h :id) (get (host :conversations) [(s :identity) (c :world) (c :conversation)])) (c :conversation))
          :source {:key (source :key) :conversation (c :conversation)} :author (source :author)
          :at (source :at) :text (source :text) :world-point (get-in h [:run :expected] (get-in base [:data :world-point])) :bindings (when base (if (base :image) (base :id) (get-in base [:data :bindings])))}))
        (def memory (memory/extend s r roots c))
        (when (h :run) (put (h :run) :memory memory))))
    (store/save s h)
    {:path (h :id) :point (h :point)}))
(defn invoke [bytes c imports]
  (def host (dyn :zinc/host)) (def caller (dyn :zinc/caller)) (def attachment (dyn :zinc/attachment))
  (def operation (c :operation))
  (when (= operation "render")
    (assert (c :inspect) "inspection not granted")
    (def source (storage host (merge c {:temporary false}))) (put source :config c)
    (def h (selected host source c true))
    (def point (when (h :point) (store/nearest source (h :point) (get-in c [:arguments :reference]) caller)))
    (put c :temporary true) (put c :path nil) (put c :from point))
  (def s (storage host c)) (put s :config c) (put attachment :store s)
  (when (c :initialize) (break true))
  (def args (c :arguments))
  (case operation
    "models" (break (filter |(= (get args :role "chat") ($ :role)) (effects/catalogue c)))
    "read" (do (store/permit s (store/head s (get-in c [:work :path]))) (break (store/result s (c :work))))
    "cancel" (break (cancel host s (c :work))))
  (when (index-of operation ["world-point" "world-view" "world-inspect" "memory-expand" "memory-invalidate"])
    (assert (c :inspect) "inspection not granted")
    (def h (selected host s c true))
    (def exact (if (= operation "memory-invalidate") (store/access s (or (args :reference) (h :point)))
      (when (h :point) (store/nearest s (h :point) (args :reference) caller))))
    (def roots (when exact (get-in (store/row s exact) [:data :memory])))
    (when (args :node) (memory/allowed s (args :node) roots))
    (break (case operation
      "world-point" exact
      "world-view" {:point exact :language "clojure" :text (view s exact c)}
      "world-inspect" {:point exact :event ((store/row s exact) :data)}
      "memory-expand" {:point exact :sources (if (args :node) (memory/render s (args :node)) (memory/sources s roots))}
      "memory-invalidate" (do (assert (get-in c [:registry :user "memory/invalidate"]) "summary invalidation not granted")
        (assert (args :node) "supply an exact subtree address") (store/transact s (memory/invalidate s (args :node) roots))))))
  (assert (index-of operation ["submit" "resume" "memory-summarize" "render"]) "unknown Zinc operation")
  (when (= operation "memory-summarize")
    (assert (get-in c [:registry :user "memory/summarize"]) "summary generation not granted")
    (when (args :point) (put c :memory (store/access s (args :point)))))
  (put c :catalogue (effects/catalogue c))
  (var cursor (if (s :db) ((first (store/query s "SELECT coalesce(max(id),0) n FROM journal")) :n) (s :next-row)))
  (def work (if (= operation "resume") (do (store/permit s (store/head s (get-in c [:work :path]))) (c :work))
    (let [input (if (index-of operation ["memory-summarize" "render"]) {:code "nil"}
      (merge (if (= "json" (c :input)) (postwalk |(if (= $ :null) nil $) (json/decode bytes true true)) {(keyword (c :input)) bytes})))]
      (each key [:request :path :from :memory] (when (c key) (put input key (c key))))
      (unless (or (input :path) (input :from)) (put input :path ((selected host s c) :id)))
      (store/transact s (store/admit s input (merge c {:role (if (and (input :code) (not= operation "render")) :user :agent)}) caller)))))
  (put (host :owners) [(s :identity) (work :request)] attachment)
  (def requests @{(work :request) true}) (def delivered @{}) (var active nil) (var result nil)
  (ev/give (host :events) {:type "wake"})
  (while true
    (each a (sorted (store/pending s) |(< ($0 :depth) ($1 :depth))) (when (requests (a :owner)) (put requests (a :request) true)))
    (each r (rows s cursor)
      (when (and (requests (get-in r [:data :request])) (get-in r [:data :presentation])
        (index-of (get-in r [:data :presentation :type]) (c :publish)))
        (when-let [emit (module/value imports 'output)]
          (def output (merge (get-in r [:data :presentation]) {:text (store/text r)}))
          (emit output)
          (when (and (= "response" (output :type)) (not (output :footer))) (put delivered (output :id) (r :id)))))
      (set cursor (r :id)))
    (each [id point] (pairs delivered)
      (def r (store/row s point)) (def footer (get-in r [:data :presentation :footer]))
      (when (and (get-in r [:data :terminal]) footer)
        ((module/value imports 'output) {:type "metadata" :id id :footer footer}) (put delivered id nil)))
    (def working (some |(requests (get-in $ [:run :active :request])) (values (s :heads))))
    (unless (= active working) (set active working)
      (when-let [emit (module/value imports 'output)] (emit {:type "activity" :active (not (nil? active))})))
    (set result (or (get (host :results) (work :request)) (store/result s work)))
    (when result (break)) (ev/sleep 0.01))
  (unless (= "ok" (result :status)) (error (get result :error {:code "Cancelled" :message "Work cancelled."})))
  (when (or (not= "submit" operation) (not (module/value imports 'output)))
    (if (result :output) result (result :value))))
(defn main []
  (unless (index-of (os/which) [:windows :mingw]) (os/umask 8r077) (os/sigaction :pipe (fn [])))
  (def handle (os/getenv "PA_HANDLE")) (def limit (scan-number (os/getenv "PA_FRAME_BYTES")))
  (assert (and (string? handle) (int? limit) (> limit 0)) "PA_HANDLE and PA_FRAME_BYTES required")
  (def host @{:events (ev/thread-chan 256) :stores @{} :conversations @{} :attachments @{} :active @{} :effects @{} :results @{} :owners @{}})
  (ev/go (fn [] (while true (ev/sleep 0.02) (ev/give (host :events) {:type "wake"}))))
  (ev/go (fn []
    (while true
      (def event (ev/take (host :events)))
      (when (event :identity)
        (def s (find |(= (event :identity) ($ :identity)) (values (host :stores))))
        (def h (store/head s (event :path)))
        (when (= "step" (event :type)) (put (host :active) [(s :identity) (h :id)] nil))
        (when (= "receipt" (event :type)) (put (host :effects) [(s :identity) (event :request) (event :index)] nil))
        (when (= (event :request) (get-in h [:run :active :request]))
          (try (case (event :type)
            "step" (commit-step host s h (event :packet) (event :counts))
            "receipt" (receipt host s h (event :index) (event :result))
            "item" (store/transact s (put s :config (get-in h [:run :active :policy])) (item s h (event :index) (event :item)) (store/save s h)))
            ([err fiber] (eprint (config/encode (config/diagnostic err fiber)))
              (finish host s h {:status "error" :error (config/diagnostic err fiber)}))))
        (when (and (= "receipt" (event :type)) (string? (event :binding))
          (not= (event :request) (get-in h [:run :active :request])))
          (put s :config (event :policy))
          (store/transact s
            (def previous (when (h :point) (store/row s (h :point))))
            (def r (store/append s h {:kind "result" :request (event :request) :path (h :id) :world (event :world)
              :author (get-in event [:policy :handle]) :at (os/clock) :outcome (event :result)
              :bindings (when previous (if (previous :image) (previous :id) (get-in previous [:data :bindings])))
              :world-point (get-in previous [:data :world-point])
              :presentation {:type "tool-result" :id (string (event :request) "/" (event :index) "/result")
                :reply (string (event :request) "/" (event :index) "/call")}}))
            (def roots (memory/extend s r (get-in h [:run :memory] (get-in previous [:data :memory] [])) (event :policy)))
            (when (h :run) (put (h :run) :memory roots)) (store/save s h)))
        (when (= "receipt" (event :type))
          (each job (values (get s :summary-work {}))
            (when (= (job :origin) [(event :request) (event :index)])
              (put job :result (event :result))
              (each waiter (job :waiters)
                (put (host :effects) [(s :identity) (waiter :request) (waiter :index)] nil)
                (def target (store/head s (waiter :path)))
                (when (= (waiter :request) (get-in target [:run :active :request]))
                  (receipt host s target (waiter :index) (event :result)))))))
        (when (event :ack) (ev/give (event :ack) true)))
      (schedule host))))
  (pa/serve handle limit (fn [message reverse]
    (def method (message :method)) (def params (postwalk |(if (= $ :null) nil $) (message :params)))
    (def supplied (case method "describe" params "position" params "append" (params 0) "invoke" (params 1) (error "unknown agent method")))
    (def c (config/parse supplied handle runtime))
    (when (= method "describe") (break (config/discover c)))
    (def imports @{})
    (when (= method "invoke")
      (assert (and (indexed? params) (= 3 (length params)) (dictionary? (params 2))) "expected invoke(input, config, imports)")
      (each [name documentation] (pairs (params 2))
        (assert (string? documentation) "invalid import documentation")
        (put imports (symbol name) @{:doc documentation :value (fn [value] (reverse (string name) value))})))
    (put c :registry (tabseq [role :in [:user :agent]] role (config/registry c role imports)))
    (put c :instructions-text (string (slurp (c :instructions))))
    (def attachment @{:config c :imports imports :open true})
    (put (host :attachments) (message :id) attachment)
    (defer (do (put attachment :open false)
        (when-let [s (attachment :store)]
          (when (and (empty? (store/pending s))
            (not (find |(= (s :identity) ($ 0)) (keys (host :effects))))
            (not (find |(= (s :identity) ($ 0)) (keys (host :active)))))
            (put (host :attachments) (message :id) nil)
            (when (c :temporary)
              (each [key value] (pairs (host :stores)) (when (= value s) (put (host :stores) key nil)))
              (store/close s)))))
      (case method
        "invoke" (with-dyns [:zinc/host host :zinc/caller (message :caller) :zinc/attachment attachment]
          (invoke (base64/decode (params 0)) c imports))
        "append" (let [s (storage host c)] (put attachment :store s) (append-evidence host s c (params 1)))
        "position" (let [s (storage host c)] (put attachment :store s) (def h (selected host s c))
          (var p (h :point)) (var key nil)
          (while (and p (not key)) (def r (store/row s p)) (set key (get-in r [:data :source :key])) (set p (r :previous)))
          {:path (h :id) :point (h :point) :source key}))))))

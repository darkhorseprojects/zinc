(import ./policy)
(import ./store)
(import ./vm)
(import ./model)
(import ./memory)
(import ./effects)
(defn record [s h a data &opt image evidence]
  (def run (h :run)) (def c (a :policy))
  (def changed (and image (run :dirty)))
  (def r (store/append s h (merge {:request (a :request) :path (h :id) :world (run :world)
    :bindings (run :bindings-point) :world-point (run :expected) :author (c :handle) :at (os/clock)} data) c (when changed image)))
  (put run :memory (memory/extend s r (run :memory) c false evidence))
  (when changed (put run :dirty false) (put run :bindings-point (r :id)))
  r)
(defn update [run r]
  (unless (run :updates) (put run :updates @[]))
  (array/push (run :updates) {:id (r :id) :text (store/text r)}))
(defn notify-parent [s a r]
  (when-let [owner (a :owner) h (find |(= owner (get-in $ [:run :active :request])) (values (s :heads)))]
    (def run (h :run)) (def c (get-in run [:active :policy]))
    (put run :memory (memory/extend s r (run :memory) c true)) (update run r) (store/save s h c)))
(defn append-event [host s h c data]
  (def base (store/anchor host s h c))
  (def r (store/append s h (merge base {:at (os/clock)} data) c))
  (def roots (memory/extend s r (base :memory) c))
  (when (h :run) (put (h :run) :memory roots)) r)
(defn finish [host s h outcome &opt packet]
  (def run (h :run)) (def a (run :active)) (def c (a :policy))
  (store/transact s
    (if (not= "submit" (c :operation)) (put (host :results) [(s :identity) (a :request)] outcome)
      (do
        (def world (store/world s (run :world)))
        (def conflict (and (= "ok" (outcome :status)) (run :changed) (not= (run :expected) (world :point))))
        (def result (if conflict {:status "error" :error {:code "WorldChanged"
          :message "World publication conflicted. Candidate bindings are retained; effects were not repeated."}} outcome))
        (def existing (when (and (= "ok" (result :status)) (run :answer)) (store/row s (run :answer))))
        (def r (or existing (record s h a {:kind "result" :outcome result
          :publish (if (= "ok" (result :status)) "tool-result" "diagnostic") :reply (when (get-in a [:input :code]) (a :start))} (get packet :bindings))))
        (when (and existing (run :dirty) (packet :bindings))
          (put r :image (packet :bindings)) (put run :bindings-point (r :id)))
        (merge-into (r :data) {:terminal true :outcome (if existing {:status (result :status)} result)
          :bindings (run :bindings-point)})
        (store/replace s r c) (notify-parent s a r)
        (when (and (run :changed) (= "ok" (result :status)))
          (put (r :data) :world-point (r :id)) (store/replace s r c)
          (put world :point (r :id)) (store/save s world c))))
    (def queue (run :queue))
    (put (host :owners) [(s :identity) (a :request)] nil)
    (put h :run (when (not (empty? queue)) @{:queue queue})) (store/save s h c)))
(defn submit [host s input c caller]
  (def operation (c :operation))
  (unless (or (input :path) (input :from)) (put input :path ((store/selected host s c) :id)))
  (store/transact s
    (def grant (merge c {:role (if (and (input :code) (not= operation "render")) :user :agent)}))
    (def work (store/admit s input grant caller))
    (when (and (s :db) (= operation "submit") (get-in input [:source :key]))
      (def h (store/head s (work :path)))
      (when-let [a (find |(= ($ :request) (work :request)) (get-in h [:run :queue] []))]
        (unless (a :start)
          (def key (get-in input [:source :key]))
          (assert (string? key) "invalid source key")
          (def prior (find |(= ($ :key) key) (store/intake s (h :point) (c :conversation) [key])))
          (def r (store/append s h (merge (store/anchor host s h c) {:kind "input" :author caller
            :request (a :request) :signature (a :signature) :scope (c :scope) :at (get input :at (os/clock))
            :evidence (get prior :id) :source (unless prior {:key key :conversation (c :conversation)})
            :text (unless prior (or (input :text) (input :code)))
            :input {:type (if (input :code) "code" "text") :images (get input :images [])}}) c))
          (put a :start (r :id)) (store/save s h grant))))
    work))
(defn cancel [host s work c]
  (store/permit s (store/head s (work :path)) c)
  (def owned @{(work :request) true})
  (each a (sorted (store/pending s) |(< ($0 :depth) ($1 :depth)))
    (when (owned (a :owner)) (put owned (a :request) true)))
  (store/transact s
    (each h (values (s :heads)) (when-let [run (h :run)]
      (def removed (filter |(owned ($ :request)) (get run :queue [])))
      (put run :queue (filter |(not (owned ($ :request))) (get run :queue [])))
      (each a removed
        (notify-parent s a (append-event host s h (a :policy) {:kind "result" :request (a :request) :author (a :author)
          :signature (a :signature) :scope (get-in a [:policy :scope]) :terminal true
          :outcome {:status "cancelled" :error {:code "Cancelled" :message "Cancelled before execution."}}})))
      (if (owned (get-in run [:active :request]))
        (finish host s h {:status "cancelled" :error {:code "Cancelled" :message "Cancelled; dispatched actions are not undone."}})
        (do (when (and (not (run :active)) (empty? (run :queue))) (put h :run nil)) (store/save s h (or (get-in run [:active :policy]) c))))))) true)
(defn local [host s h a c packet binding args]
  (def run (h :run))
  (case binding
    :exposure (let [selected (model/select c "chat") window (model/window selected c)]
      (merge (vm/expose c (packet :role)) {:instructions (c :instructions-text) :window window
        :memory (math/floor (* window (/ (c :context-percent) 100))) :reserve (min (get c :output 4096) (get selected :output 4096))}))
    :memory-plan (memory/plan s (get run :memory []) c (args 0) (args 1) (args 2))
    :memory-select (memory/finish s (args 0) (args 1) c)
    :memory-save (memory/save s (args 0) (args 1) c (run :memory))
    :memory-summary (let [request (first args) point (request :point)
      roots (if point (get-in (store/row s (store/access s point c)) [:data :memory]) (run :memory))]
      (assert (not (empty? roots)) "empty memory")
      (def refs (if (request :node) [(memory/allowed s (request :node) roots c)] roots))
      (when (request :text) (assert (= 1 (length refs)) "manual text requires one subtree"))
      (map |(memory/need s $ c (get-in c [:summary :max-bytes]) (request :text)) refs))
    "world/view" (vm/view (store/image s (store/access s (first args) c)) c)
    "world/point" (h :point)
    "world/rewind" (do
      (assert (c :rewind) "world rewind not granted")
      (def point (store/access s (first args) c))
      (def world (store/world s (run :world)))
      (assert (= (run :expected) (world :point)) "world publication conflict")
      (def target (store/row s point))
      (def r (record s h a {:kind "result" :text (string "World rewound to #" point)
        :bindings (if (target :image) point (get-in target [:data :bindings]))}))
      (put world :point (r :id)) (store/save s world c) (r :id))
    "self" (let [input (merge (first args))]
      (unless (or (input :path) (input :from)) (when (h :point) (put input :from (h :point))))
      (def child-config (merge c {:role (packet :role) :operation "submit"}))
      (def work (store/admit s input child-config (a :author) a
        {:image (packet :bindings) :memory (run :memory) :world (run :world) :expected (run :expected)
         :dirty (run :dirty) :point (run :bindings-point)}))
      (def attachment (get (host :owners) [(s :identity) (a :request)]))
      (put (host :owners) [(s :identity) (work :request)] attachment)
      (when (get attachment :open) (put (attachment :requests) (work :request) true)) work)
    "self/result" (do (store/permit s (store/head s ((first args) :path)) c) (store/result s (first args)))
    "self/cancel" (cancel host s (first args) c)
    "memory/expand" (let [ref (first args)]
      (if (indexed? ref) (do (memory/allowed s ref (run :memory) c) {:node ref :children (tabseq [key :in [:left :right]] key (get (memory/node s ref) key)) :text (memory/render s ref)})
        (memory/sources s (if ref (get-in (store/row s (store/access s ref c)) [:data :memory]) (run :memory)) c)))
    "memory/invalidate" (memory/invalidate s (first args) (run :memory) c)
    "time/now" (os/clock)
    "random/bytes" (do (assert (and (int? (first args)) (<= 1 (first args) 4096)) "invalid random byte count")
      (string/join (map |(string/format "%02x" $) (string/bytes (os/cryptorand (first args))))))
    (error (string "unknown runtime operation " binding))))
(defn item [s h index response]
  (def run (h :run)) (def a (run :active)) (def call ((run :calls) index))
  (unless (call :seen) (put call :seen @{}))
  (var tool 0)
  (each output (response :outputs)
    (def script (when (= "tool-call" (output :type)) (get (response :calls) (- (++ tool) 1))))
    (unless (get (call :seen) (output :id))
    (def r (record s h a {:kind "message" :text (output :text)
      :publish (output :type) :language (output :language)}))
    (put (call :seen) (output :id) (r :id))
    (when script
      (when (script :error)
        (def failed (record s h a {:kind "result" :outcome {:status "error" :error (script :error)}
          :publish "tool-result" :reply (r :id)}))
        (put (call :seen) (string (output :id) "/rejected") (failed :id)))
      (unless (run :items) (put run :items @[]))
      (array/push (run :items) {:model (get-in call [:arguments 0 :output]) :call script :output (r :id)})))))
(defn receipt [host s h index outcome]
  (def run (h :run)) (def a (run :active)) (def c (a :policy)) (def call ((run :calls) index))
  (unless (call :result)
    (def result (merge outcome))
    (store/transact s
      (when (and (= :chat (call :binding)) (= "ok" (result :status)) (not (get-in call [:arguments 0 :summary])))
        (item s h index (result :value))
        (put result :value (merge (result :value) {:message (merge (get-in result [:value :message]) {:sources (values (call :seen))})}))
        (when (index-of (get-in result [:value :stop]) ["answer" "refused"])
          (def last-output (last (filter |(= "response" ($ :type)) (get-in result [:value :outputs]))))
          (when last-output (put run :answer (get (call :seen) (last-output :id))))))
      (put call :result result)
      (unless (keyword? (call :binding))
        (def r (record s h a {:kind "result" :outcome result
          :publish "tool-result" :reply (call :point)}))
        (update run r))
      (store/save s h c))))
(defn start [host s h c]
  (def run (h :run)) (def a (first (run :queue)))
  (array/remove (run :queue) 0) (put run :active a) (put run :calls @[])
  (def base (when (h :point) (store/row s (h :point))))
  (def name (get-in a [:seed :world] (get-in base [:data :world] (c :world))))
  (assert (index-of name (c :worlds)) "world not granted")
  (def world (store/world s name)) (def origin (or (h :point) (world :point)))
  (put run :world name) (put run :expected (get-in a [:seed :expected] (get-in base [:data :world-point] (world :point))))
  (put run :machine (or (get-in a [:seed :image]) (store/image s origin)))
  (put run :dirty (get-in a [:seed :dirty] false)) (put run :changed (run :dirty))
  (put run :bindings-point (get-in a [:seed :point] (when origin (def original (store/row s origin))
    (if (original :image) origin (get-in original [:data :bindings])))))
  (put run :memory (if-let [point (get-in a [:input :memory])]
    (get-in (store/row s (store/access s point c)) [:data :memory])
    (get-in a [:seed :memory] (get-in base [:data :memory] []))))
  (put a :seed nil)
  (store/transact s
    (when (= "submit" (c :operation))
      (def r (if-let [admitted (a :start)]
        (let [prior (get-in (store/row s admitted) [:data :evidence])]
          (record s h a {:kind "start" :evidence (or prior admitted)} nil (unless prior admitted)))
        (record s h a {:kind "input" :text (or (get-in a [:input :text]) (get-in a [:input :code]))
          :author (a :author) :at (get-in a [:input :at] (os/clock))
          :conversation (when (= (h :id) (get (host :conversations) [(s :identity) (c :world) (c :conversation)])) (c :conversation))
          :signature (a :signature) :scope (c :scope)
          :admission {:owner (a :owner) :depth (a :depth)}
          :input {:type (if (get-in a [:input :code]) "code" "text") :images (get-in a [:input :images] [])}})))
      (put a :start (r :id)) (put-in a [:input :source] (get-in r [:data :evidence] (r :id)))
      (when (get-in a [:input :code])
        (merge-into (r :data) {:publish "tool-call" :language "clojure"})
        (store/replace s r c)))
    (store/save s h c)))
(defn commit-step [host s h packet counts c]
  (def run (h :run)) (def a (run :active))
  (if (packet :failure) (finish host s h {:status "error" :error (packet :failure)})
    (store/transact s
      (put run :machine (packet :image)) (put run :waits (packet :waits)) (put run :reply nil)
      (each [i call] (pairs (run :calls))
        (when (and call (call :result) (not (find |(= i ($ :call)) (packet :waits)))) (put (run :calls) i nil)))
      (when (packet :changed) (put run :dirty true) (put run :changed true))
      (each [key count] (pairs counts) (when (> count 0) (array/remove (run key) 0 count)))
      (each complete (packet :completed)
        (def r (record s h a {:kind "result" :outcome (complete :outcome)
          :publish "tool-result" :reply (complete :script)} (packet :bindings))) (update run r))
      (when-let [op (packet :operation)]
        (def binding (op :binding)) (def args (op :arguments))
        (cond
          (or (index-of binding [:chat :rerank]) (= "external" (get-in c [:registry (packet :role) binding :class])))
          (do
            (def index (length (run :calls)))
            (def arguments (if (index-of binding [:chat :rerank])
              [(merge (model/prepare c (first args) (= binding :rerank)) {:output (string (a :request) "/" index)})] args))
            (array/push (run :calls) @{:binding binding :role (packet :role) :arguments arguments})
            (unless (keyword? binding)
              (put (last (run :calls)) :point ((record s h a {:kind "message" :text (string/format "%j" (tuple (symbol binding) ;args))
                :publish "tool-call" :language "clojure"} (packet :bindings)) :id))))
          (= binding :await)
          (do (def work (first args)) (store/permit s (store/head s (work :path)) c)
            (assert (not= (a :request) (work :request)) "cannot await own inquiry")
            (if-let [result (store/result s work)] (put run :reply [(packet :task) result])
              (do (assert (find |(= (work :request) ($ :request)) (store/pending s)) "work unavailable")
                (assert (not (store/reaches? s (work :path) (h :id))) "cyclic work wait"))))
          (put run :reply [(packet :task) (try {:status "ok" :value (local host s h a c packet binding args)}
            ([err fiber] {:status "error" :error (policy/diagnostic err fiber)}))])))
      (if (packet :settled) (finish host s h (packet :settled) packet) (store/save s h c)))))
(defmacro effect-outcome [c expr]
  ~(try (let [v ,expr]
    (assert (<= (length (,policy/encode v)) (,c :response-bytes)) "effect response limit")
    {:status "ok" :value (if (nil? v) :null v)})
    ([err fiber] {:status (get-in err [:context :outcome] "unknown") :error (,policy/diagnostic err fiber)})))
(defn dispatch [host s h index authority c]
  (def run (h :run)) (def a (run :active)) (def call ((run :calls) index))
  (def key [(s :identity) (a :request) index]) (def binding (call :binding))
  (def spec (if (keyword? binding) {} (get-in c [:registry (call :role) binding])))
  (when (and (string? binding) (not spec) (not (call :dispatched)) (not (call :result)))
    (break (receipt host s h index {:status "error" :error {:code "BindingNotGranted" :message (string "Binding not granted: " binding)}})))
  (def imported (when (and (get spec :import) (authority :open)) (module/value (authority :imports) (symbol binding))))
  (def prepared (when (= binding :chat) (first (call :arguments))))
  (def summary-key (when (get prepared :summary) [(prepared :node) (prepared :recipe) (prepared :quota)]))
  (unless (s :summary-work) (put s :summary-work @{}))
  (def job (when summary-key (find |(and (= ($ :key) summary-key) (not ($ :cancelled))) (values (s :summary-work)))))
  (cond
    (call :result) nil
    (and job (not (call :dispatched)) (not (get (host :effects) key)))
    (do (put (host :effects) key true)
      (array/push (job :waiters) {:path (h :id) :request (a :request) :index index}))
    (or (get (host :effects) key) (and (get spec :import) (not imported) (not (call :dispatched)))) nil
    (call :dispatched)
    (receipt host s h index {:status "unknown" :error {:code "EffectOutcomeUnknown" :message "Dispatched without an outcome; not repeated."}})
    (do
      (def cancel (when summary-key (ev/thread-chan 1)))
      (when summary-key (put (s :summary-work) [summary-key (a :request) index]
        @{:node (prepared :node) :origin [(a :request) index] :key summary-key :cancel cancel :waiters @[]}))
      (put call :dispatched true) (store/save s h c) (put (host :effects) key true)
      (def event {:type "receipt" :started (when (c :profile) (os/clock)) :identity (s :identity) :path (h :id) :request (a :request) :index index
        :binding binding :policy c :world (run :world) :reply (call :point)})
      (def events (host :events)) (def args (call :arguments))
      (if imported (ev/spawn (ev/give events (merge event {:result (effect-outcome c (imported (first args)))})))
        (ev/thread (fn [[event events args spec c cancel]]
          (def owner (fiber/root))
          (def watcher (when cancel (ev/spawn (ev/take cancel) (ev/cancel owner {:code "SummaryInvalidated" :message "Summary work invalidated."}))))
          (def result (effect-outcome c (effects/invoke c spec (case (event :binding) :chat "model/chat" :rerank "model/rerank" (event :binding)) args
            (fn [item] (def ack (ev/thread-chan 1))
              (defer (ev/chan-close ack) (ev/give events (merge event {:type "item" :item item :ack ack})) (ev/take ack))))))
          (when watcher (ev/cancel watcher :finished))
          (ev/give events (merge event {:result result})))
          [event events args spec (merge c (get-in c [:vm (call :role)])) cancel] :n)))))
(defn schedule [host]
  (var retry true)
  (while retry (set retry false)
  (each s (values (host :stores))
    (each h (values (s :heads)) (when (h :run)
      (def key [(s :identity) (h :id)])
      (unless (get (host :active) key)
        (def a (or (get-in h [:run :active]) (first (get-in h [:run :queue]))))
        (def owner (get (host :owners) [(s :identity) (a :request)]))
        (def grant (get (host :grants) [(s :identity) (get-in a [:policy :scope :authority])]))
        (when-let [[authority c] (some |(when $ (try [$ (policy/authorize ($ :config) (a :policy))] ([err] nil)))
          [(when (get owner :open) owner) grant])]
          (try (do
            (unless (get-in h [:run :active])
              (unless (find |(and (a :owner) (= (a :owner) ($ :owner)) (get-in a [:input :queue])
                (get-in $ [:input :queue]) (< ($ :order) (a :order))) (store/pending s)) (start host s h c)))
            (when (get-in h [:run :active])
              (def run (h :run))
              (when (and (a :deadline) (<= (a :deadline) (os/clock))) (error {:code "DeadlineExceeded" :message "Inquiry deadline expired."}))

                  (each [i call] (pairs (run :calls)) (when (and call (< (length (host :effects)) (c :parallel))) (dispatch host s h i authority c)))
                  (def ready (or (run :reply) (not (run :waits)) (not (empty? (get run :items []))) (not (empty? (get run :updates [])))
                    (some |(or (and (has-key? $ :call) (get-in run [:calls ($ :call) :result]))
                      (and (has-key? $ :timer) (<= ($ :timer) (os/clock)))
                      (and (has-key? $ :request) (store/result s $))) (run :waits))))
                  (when (and ready (< (length (host :active)) (c :parallel)))
                    (put (host :active) key (a :request))
                    (def counts {:items (length (get run :items [])) :updates (length (get run :updates []))})
                    (def args {:image (run :machine) :input (a :input) :config c :request (a :request) :calls (run :calls)
                      :reply (run :reply) :now (os/clock) :items (get run :items []) :updates (get run :updates [])
                      :children (some |(= (a :request) ($ :owner)) (store/pending s))
                      :results (tabseq [wait :in (get run :waits []) :when (has-key? wait :request) :let [r (store/result s wait)] :when r] (wait :request) r)})
                    (ev/thread (fn [[events event args]]
                      (def c (args :config))
                      (def packet (try (do (unless (c :catalogue) (put c :catalogue (effects/catalogue c))) (vm/step args))
                        ([err fiber] {:failure (policy/diagnostic err fiber)})))
                      (ev/give events (merge event {:config c :packet packet})))
                      [(host :events) {:type "step" :started (when (c :profile) (os/clock)) :identity (s :identity) :path (h :id) :request (a :request) :counts counts} args] :n))))
            ([err fiber] (put (host :active) key nil)
              (when (get-in h [:run :active])
                (finish host s h {:status "error" :error (policy/diagnostic err fiber)}) (set retry true)))))))))))

(defn open []
  (def host @{:events (ev/thread-chan 256) :stores @{} :conversations @{} :attachments @{} :active @{} :effects @{} :results @{} :owners @{} :grants @{}})
  (ev/go (fn []
    (var alarm nil)
    (while true
      (def event (ev/take (host :events)))
      (when (event :identity)
        (def s (find |(= (event :identity) ($ :identity)) (values (host :stores))))
        (def h (store/head s (event :path)))
        (when-let [started (event :started)] (eprint (policy/encode {:event (event :type) :request (event :request) :ms (* 1000 (- (os/clock) started))})))
        (when (and (= (event :type) "step") (= (event :request) (get (host :active) [(s :identity) (h :id)]))) (put (host :active) [(s :identity) (h :id)] nil))
        (when (= "receipt" (event :type)) (put (host :effects) [(s :identity) (event :request) (event :index)] nil))
        (when (= (event :request) (get-in h [:run :active :request]))
          (try (case (event :type)
            "step" (do (put (get-in h [:run :active :policy]) :catalogue (get-in event [:config :catalogue]))
              (commit-step host s h (event :packet) (event :counts) (event :config)))
            "receipt" (receipt host s h (event :index) (event :result))
            "item" (store/transact s (item s h (event :index) (event :item)) (store/save s h (get-in h [:run :active :policy]))))
            ([err fiber] (eprint (policy/encode (policy/diagnostic err fiber)))
              (finish host s h {:status "error" :error (policy/diagnostic err fiber)}))))
        (when (and (= "receipt" (event :type)) (string? (event :binding))
          (not= (event :request) (get-in h [:run :active :request])))
          (store/transact s
            (append-event host s h (event :policy) {:kind "result" :request (event :request) :world (event :world) :publish "tool-result"
              :author (get-in event [:policy :handle]) :outcome (event :result) :reply (event :reply)})
            (store/save s h (event :policy))))
        (when (= "receipt" (event :type))
          (each [key job] (pairs (get s :summary-work {}))
            (when (= (job :origin) [(event :request) (event :index)])
              (put (s :summary-work) key nil) (ev/chan-close (job :cancel))
              (each waiter (job :waiters)
                (put (host :effects) [(s :identity) (waiter :request) (waiter :index)] nil)
                (def target (store/head s (waiter :path)))
                (when (= (waiter :request) (get-in target [:run :active :request]))
                  (receipt host s target (waiter :index) (event :result)))))))
        (when (event :ack) (ev/give (event :ack) true)))
      (schedule host)
      (each attachment (values (host :attachments))
        (when (and (attachment :open) (attachment :requests) (= 0 (ev/count (attachment :changed))))
          (ev/give (attachment :changed) true)))
      (each [key s] (pairs (host :stores))
        (when (and (not (s :db)) (empty? (store/pending s))
          (not (find |(and ($ :open) (= s ($ :store))) (values (host :attachments))))
          (not (find |(= (s :identity) ($ 0)) (array/concat @[] (keys (host :active)) (keys (host :effects))))))
          (put (host :stores) key nil)
          (each key (keys (host :conversations)) (when (= (s :identity) (key 0)) (put (host :conversations) key nil)))
          (store/close s)))
      (def now (os/clock)) (var next nil)
      (each s (values (host :stores)) (each h (values (s :heads)) (when-let [run (h :run)]
        (each due (array/concat @[(get-in run [:active :deadline])] (map |($ :timer) (get run :waits [])))
          (when (and due (> due now)) (set next (min (or next due) due))))))
      (unless (= next (get alarm 0))
        (when alarm (ev/cancel (alarm 1) :rescheduled))
        (set alarm (when next [next (ev/go (fn []
          (try (do (ev/sleep (max 0 (- next (os/clock)))) (ev/give (host :events) {:type "wake"}))
            ([err] (unless (= err :rescheduled) (eprint (policy/encode (policy/diagnostic err))))))))])))))))
  host)

(import spork/json :as json)
(import ./config)

(def tool {:name "janet" :description "Execute a Janet script. Use self for recursive agent work."
  :parameters {:type "object" :additionalProperties false :required ["code"] :properties {:code {:type "string" :minLength 1}}}})
(defn estimate [value]
  (math/ceil (/ (length (config/encode (postwalk |(if (and (dictionary? $) (= "image" ($ :type)))
    {:type "image" :url "[provider-dependent image tokens]"} $) value))) 4)))
(defn text [parts] (string/join (map |($ :text) (filter |(= "text" ($ :type)) parts)) "\n"))

(defn catalogue [c records properties]
  (catseq [[name endpoint] :pairs (c :providers)]
    (def raw (get records name []))
    (def configured (get endpoint :models {}))
    (def all (if (endpoint :catalogue) raw
      (seq [[id spec] :pairs configured] {:id (string id) :role (spec :role)})))
    (seq [r :in all :let [id (r :id) spec (get configured (keyword id))]
      :when (or (not (has-key? endpoint :models)) spec)]
      (def props (get properties (string name ":" id)))
      (def parameters (get r :supported_parameters []))
      (def caps (get props :chat_template_caps {}))
      (def context (min (get r :context_length math/inf) (get-in r [:top_provider :context_length] math/inf)
        (get-in props [:default_generation_settings :n_ctx] math/inf) (get spec :context math/inf)))
      (assert (and (int? context) (> context 1)) (string "context capacity required for " name ":" id))
      (merge {:ref (string name ":" id) :provider (string name) :id id :name (get r :name id)
        :role (get spec :role (get r :role "chat")) :context context
        :protocol (get endpoint :protocol "chat-completions")
        :tools (if props (and (caps :supports_tools) (caps :supports_tool_calls)) (not (nil? (index-of "tools" parameters))))
        :parallel (if props (caps :supports_parallel_tool_calls) (not (nil? (index-of "parallel_tool_calls" parameters))))
        :images (if props (get-in props [:modalities :vision]) (not (nil? (index-of "image" (get-in r [:architecture :input_modalities] [])))))
        :control (if props (when (caps :supports_reasoning_effort) "reasoning_effort")
          (cond (index-of "reasoning" parameters) "reasoning" (index-of "reasoning_effort" parameters) "reasoning_effort"))
        :efforts (if props (caps :reasoning_effort_levels) (get-in r [:reasoning :supported_efforts]))
        :reasoning-required (get-in r [:reasoning :mandatory])
        :output (get-in r [:top_provider :max_completion_tokens])
        :output-field (if (= "responses" (endpoint :protocol)) "max_output_tokens" "max_tokens")}
        (or spec {}) {:ref (string name ":" id) :provider (string name) :id id :context context}))))

(defn select [c role &opt reference]
  (def ref (or reference (c (if (= role "rerank") :rerank :chat))))
  (def selected (find |(and (= ref ($ :ref)) (= role ($ :role))) (c :catalogue)))
  (assert selected (string "model unavailable: " ref)) selected)

(defn prepare [c input &opt rerank]
  (def settings (if (input :summary) (merge c (c :summary) {:web-search false}) c))
  (def selected (select settings (if rerank "rerank" "chat") (input :model)))
  (def endpoint (get-in c [:providers (keyword (selected :provider))]))
  (def protocol (selected :protocol))
  (assert (index-of protocol ["chat-completions" "responses"]) "unsupported model protocol")
  (def messages (input :messages))
  (def size (estimate (if rerank input messages)))
  (def window (min (selected :context) (get c :context-quota math/inf)))
  (def maximum (min (if (input :summary) (c :summary-quota) window) (get selected :output window) (get c :output window) (get input :output window) (- window size 256)))
  (unless rerank (assert (and (> maximum 0) (<= size (* window (/ (c :context-percent) 100)))) "model context budget exhausted"))
  (def body (merge (get endpoint :parameters {}) {:model (selected :id)}))
  (if rerank
    (do
      (assert (> (length (input :query)) 0) "empty rerank query")
      (each d (input :documents) (assert (< (estimate [(input :query) d]) window) "rerank document exceeds context"))
      (merge-into body {:query (input :query) :documents (input :documents) :top_n (length (input :documents))}))
    (do
      (unless (= "none" (selected :output-field)) (put body (keyword (selected :output-field)) maximum))
      (def tools @[])
      (when (input :tools)
        (assert (selected :tools) "model does not support tools")
        (array/push tools (if (= protocol "responses") (merge tool {:type "function" :strict false}) {:type "function" :function tool})))
      (when (settings :web-search)
        (assert (> (length (get endpoint :web-tools [])) 0) "provider web tools are not configured")
        (array/concat tools (endpoint :web-tools)))
      (when (> (length tools) 0) (put body :tools tools)
        (when (selected :parallel) (put body :parallel_tool_calls true)))
      (def thinking (settings :thinking))
      (when (= thinking "none") (assert (not (selected :reasoning-required)) "model requires reasoning"))
      (unless (= thinking "default")
        (assert (selected :control) "reasoning control unsupported")
        (when (> (length (get selected :efforts [])) 0) (assert (index-of thinking (selected :efforts)) "unsupported reasoning effort"))
        (put body (if (= protocol "responses") :reasoning (keyword (selected :control)))
          (if (or (= protocol "responses") (= "reasoning" (selected :control)))
            (if (and (= thinking "none") (not= protocol "responses")) {:enabled false} {:effort thinking}) thinking)))
      (when (endpoint :cache-key) (put body :prompt_cache_key (endpoint :cache-key)))
      (def wire @[])
      (each m messages
        (def parts (get m :parts []))
        (each p parts (when (= "image" (p :type)) (assert (selected :images) "model does not support images")))
        (def replay (and (= (selected :ref) (get-in m [:replay :model])) (= protocol (get-in m [:replay :protocol]))))
        (if (= protocol "responses")
          (case (m :role)
            "system" (put body :instructions (text parts))
            "user" (array/push wire {:role "user" :content (map |(case ($ :type)
              "text" {:type "input_text" :text ($ :text)}
              "image" {:type "input_image" :image_url ($ :url)} (error "unsupported content")) parts)})
            "assistant" (if replay (array/concat wire (get-in m [:replay :items]))
              (do (when (> (length (text parts)) 0) (array/push wire {:role "assistant" :content (text parts)}))
                (each call (get m :calls []) (array/push wire {:type "function_call" :call_id (call :id)
                  :name (call :name) :arguments (call :arguments)}))))
            "tool" (array/push wire {:type "function_call_output" :call_id (m :call) :output (text parts)})
            (error "unsupported role"))
          (array/push wire
            (if (and replay (= "assistant" (m :role))) (get-in m [:replay :message])
              (merge {:role (m :role) :content (if (every? (map |(= "text" ($ :type)) parts)) (text parts)
                (map |(case ($ :type) "text" $ "image" {:type "image_url" :image_url {:url ($ :url)}}) parts))}
                (if (= "tool" (m :role)) {:tool_call_id (m :call)} {})
                (if (> (length (get m :calls [])) 0)
                  {:tool_calls (map |{:id ($ :id) :type "function" :function {:name ($ :name) :arguments ($ :arguments)}} (m :calls))} {}))))))
      (if (= protocol "responses")
        (merge-into body {:input wire :stream true :store false :include ["reasoning.encrypted_content"]})
        (merge-into body {:messages wire :stream false}))))
  {:provider (selected :provider) :selected selected :rerank rerank :manifest (input :manifest)
   :path (get endpoint (if rerank :rerank-path :chat-path) (if rerank "/v1/rerank" (if (= protocol "responses") "/v1/responses" "/v1/chat/completions")))
   :body (config/encode body)})

(defn decode [prepared bytes]
  (def selected (prepared :selected)) (def protocol (selected :protocol))
  (var raw nil)
  (if (and (= protocol "responses") (not (prepared :rerank)))
    (do
      (def items @{})
      (each block (string/split "\n\n" (string/replace-all "\r" "" bytes))
        (def lines (filter |(string/has-prefix? "data:" $) (string/split "\n" block)))
        (when (> (length lines) 0)
          (def data (string/join (map |(string/trim (string/slice $ 5)) lines) "\n"))
          (unless (= data "[DONE]")
            (def event (json/decode data true true))
            (when (= "response.output_item.done" (event :type))
              (assert (and (int? (event :output_index)) (not (has-key? items (event :output_index)))) "invalid finalized output item")
              (put items (event :output_index) (event :item)))
            (when (index-of (event :type) ["response.completed" "response.incomplete"])
              (def status (if (= "response.completed" (event :type)) "completed" "incomplete"))
              (assert (= status (get-in event [:response :status] status)) "inconsistent terminal status")
              (set raw (merge (event :response) {:status status})))
            (when (index-of (event :type) ["error" "response.failed"])
              (error {:code "ProviderError" :message (config/encode (or (event :error) (get-in event [:response :error])))})))))
      (assert raw {:code "IncompleteModelStream" :message "Responses stream has no terminal response."})
      (when (> (length items) 0)
        (def output @[]) (each i (sorted (keys items)) (assert (= i (length output)) "missing output item") (array/push output (items i)))
        (put raw :output output)))
    (set raw (json/decode bytes true true)))
  (when (prepared :rerank)
    (def count (length ((json/decode (prepared :body) true true) :documents)))
    (def seen @{})
    (each r (raw :results)
      (assert (and (int? (r :index)) (<= 0 (r :index) (- count 1)) (not (seen (r :index)))
        (number? (r :relevance_score)) (< (math/abs (r :relevance_score)) math/inf)) "invalid rerank result")
      (put seen (r :index) true))
    (assert (= count (length seen)) "incomplete rerank results")
    (break (sorted (raw :results) |(> ($0 :relevance_score) ($1 :relevance_score)))))
  (def parts @[]) (def calls @[]) (var refusal "") (var final false) (var stop nil) (var native nil)
  (if (= protocol "responses")
    (do
      (def output (raw :output)) (assert (indexed? output) "missing Responses output")
      (each item output
        (case (item :type)
          "message" (do
            (assert (and (= "assistant" (item :role)) (or (not (item :phase)) (index-of (item :phase) ["commentary" "partial_answer" "final_answer"]))) "invalid assistant message")
            (each p (item :content)
              (case (p :type) "output_text" (array/push parts {:type "text" :text (p :text)}) "refusal" (set refusal (p :refusal)))))
          "function_call" (do
            (assert (= "completed" (get item :status "completed")) "unfinished function call")
            (array/push calls @{:id (item :call_id) :name (item :name) :arguments (item :arguments)}))))
      (def last-item (last output))
      (set final (and (= "completed" (raw :status)) (= "message" (get last-item :type))
        (= "completed" (get last-item :status "completed")) (not= false (raw :end_turn)) (not (index-of (get last-item :phase) ["commentary" "partial_answer"]))
        (> (length (string/trim (text parts))) 0)))
      (set stop (if (= "completed" (raw :status)) "stop" (if (= "content_filter" (get-in raw [:incomplete_details :reason])) "content_filter" "incomplete")))
      (set native {:items output}))
    (do
      (assert (= 1 (length (raw :choices))) "expected one assistant choice")
      (def choice ((raw :choices) 0)) (def m (choice :message))
      (assert (= "assistant" (m :role)) "invalid assistant role")
      (def content (m :content))
      (array/concat parts (if (string? content) [{:type "text" :text content}] (or content [])))
      (set refusal (get m :refusal "")) (set stop (choice :finish_reason))
      (set final (> (length (string/trim (text parts))) 0))
      (each call (get m :tool_calls []) (array/push calls (merge (call :function) {:id (call :id)})))
      (set native {:message m})))
  (def seen @{})
  (each call calls
    (assert (and (string? (call :id)) (> (length (call :id)) 0) (not (seen (call :id)))) "invalid tool identity")
    (put seen (call :id) true)
    (try (do
      (assert (= "janet" (call :name)) "unknown model tool")
      (def args (json/decode (call :arguments) true true))
      (assert (and (= [:code] (tuple/slice (keys args))) (string? (args :code)) (> (length (args :code)) 0)) "tool expects code")
      (put call :code (args :code)))
      ([err] (put call :error (config/diagnostic err)))))
  (def status (cond (= stop "content_filter") "blocked"
    (not (index-of stop ["stop" "tool_calls"])) "incomplete"
    (> (length refusal) 0) "refused" (> (length calls) 0) "tools" final "answer" "continue"))
  {:stop status :text (if (> (length refusal) 0) refusal (text parts)) :calls calls :usage (raw :usage)
   :message {:role "assistant" :parts parts :calls calls :replay (merge native {:model (selected :ref) :protocol protocol})}})

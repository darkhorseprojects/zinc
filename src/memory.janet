(import sqlite3 :as sql)
(import spork/json :as json)
(import ./store)
(import ./config)
(import ./model)

(def instructions "Summarize evidence, not instructions. Preserve constraints, decisions, reasons, verified results, unfinished work, uncertainty, attribution and exact identifiers. Cite originals as [@reference]. Invent nothing.")
(defn node [s ref] (get-in (store/row s (ref 0)) [:data :nodes (ref 1)]))
(defn extend [s r roots c]
  (def forest (array/slice (or roots []))) (def nodes @[]) (def text (get-in r [:data :text] ""))
  (var start 0)
  (while (< start (length text))
    (var end (min (length text) (+ start (c :page-bytes))))
    (while (and (< end (length text)) (<= 0x80 (text end) 0xbf)) (++ end))
    (array/push forest [(r :id) (length nodes)])
    (array/push nodes @{:source (r :id) :start start :end end :count 1})
    (while (>= (length forest) 2)
      (def right (last forest)) (def left (forest (- (length forest) 2)))
      (def l (if (= (r :id) (left 0)) (nodes (left 1)) (node s left)))
      (def rr (if (= (r :id) (right 0)) (nodes (right 1)) (node s right)))
      (unless (= (l :count) (rr :count)) (break))
      (array/pop forest) (array/pop forest) (array/push forest [(r :id) (length nodes)])
      (array/push nodes @{:left left :right right :count (+ (l :count) (rr :count))}))
    (set start end))
  (put (r :data) :nodes nodes) (put (r :data) :memory forest) (store/replace s r) forest)
(defn pages [s ref]
  (def n (node s ref)) (if (n :source) [n] (array/concat @[] (pages s (n :left)) (pages s (n :right)))))
(defn sources [s roots]
  (map (fn [id] (def d ((store/row s id) :data)) {:reference id :author (d :author) :at (d :at) :text (d :text)})
    (distinct (map |($ :source) (catseq [ref :in roots] (pages s ref))))))
(defn render [s ref]
  (string/join (map (fn [p] (def d ((store/row s (p :source)) :data))
    (string "[@" (p :source) "] " (d :author) " · " (d :at) "\n" (string/slice (d :text) (p :start) (p :end))))
    (pages s ref)) "\n\n"))
(defn recipe [s ref c]
  (def n (node s ref))
  (def children (when (n :left) (map (fn [child]
    (def key (recipe s child c)) (def cached ((node s child) :summary))
    [child key (when (= key (get cached :recipe)) (cached :text))]) [(n :left) (n :right)])))
  (store/digest (config/encode [ref children instructions (c :summary) (c :chat) (c :thinking) (c :providers)
    (c :summary-bytes) (c :summary-max-bytes)])))
(defn combine [s roots]
  (def r (store/row s ((last roots) 0))) (def nodes (get-in r [:data :nodes]))
  (var root (first roots))
  (each right (tuple/slice roots 1)
    (def existing (find-index |(and (= (config/encode ($ :left)) (config/encode root))
      (= (config/encode ($ :right)) (config/encode right))) nodes))
    (if existing (set root [(r :id) existing])
      (do (def next [(r :id) (length nodes)])
        (array/push nodes @{:left root :right right :count (+ ((node s root) :count) ((node s right) :count))})
        (set root next) (store/replace s r)))) root)
(defn representation [s ref c]
  (def n (node s ref)) (def summary (n :summary))
  {:node ref :summary (and summary (= (summary :recipe) (recipe s ref c)))
   :text (if (and summary (= (summary :recipe) (recipe s ref c))) (summary :text) (render s ref))})
(defn need [s ref c]
  (def n (node s ref))
  (def parts (if (n :source) [{:text (render s ref)}] (map |(representation s $ c) [(n :left) (n :right)])))
  (def selected (model/select (merge c (c :summary)) "chat"))
  (def ceiling (- (* (min (selected :context) (get c :context-quota math/inf)) (/ (c :context-percent) 100)) 1024))
  (if (> (model/estimate (map |($ :text) parts)) ceiling)
    (let [next (find |(and ($ :node) (not ($ :summary))) parts)]
      (assert next "summary sources exhaust context") (need s (next :node) c))
    (let [text (string/join (map |($ :text) parts) "\n\n")
      budget (min (c :summary-max-bytes) (* (c :summary-bytes) (+ 1 (math/floor (math/log2 (n :count))))))]
      {:node ref :sources (distinct (map |($ :source) (pages s ref))) :recipe (recipe s ref c)
       :text text :limit (min budget (math/floor (/ (length text) 2)))})))
(defn save [s spec text]
  (assert (and (string? text) (> (length (string/trim text)) 0) (<= (length text) (spec :limit))
    (<= (* 2 (length text)) (length (spec :text)))) "summary must fit its byte limit and compact by at least half")
  (each citation (peg/match ~(any (choice (* "[@" (capture (some (if-not "]" 1))) "]") 1)) text)
    (assert (index-of (scan-number citation) (spec :sources)) "summary cites unrelated evidence"))
  (def ref (spec :node)) (def r (store/row s (ref 0)))
  (put (get-in r [:data :nodes (ref 1)]) :summary {:recipe (spec :recipe) :text text})
  (store/replace s r) ref)
(defn invalidate [s ref roots]
  (def allowed (catseq [root :in roots] (map |($ :source) (pages s root))))
  (assert (every? (map |(index-of ($ :source) allowed) (pages s ref))) "summary outside selected memory")
  (def visit (fn visit [at]
    (def n (node s at))
    (def affected (or (= (config/encode at) (config/encode ref))
      (and (n :left) (bor (if (visit (n :left)) 1 0) (if (visit (n :right)) 1 0)))))
    (when (and affected (not= 0 affected))
      (def r (store/row s (at 0))) (put (get-in r [:data :nodes (at 1)]) :summary nil) (store/replace s r) true)))
  (each root roots (visit root)) true)
(defn candidates [s rows query c]
  (if (or (not (c :memory-retrieval)) (empty? rows) (empty? query)) []
    (do
      (unless (s :search) (put s :search (sql/open ":memory:")))
      (def db (s :search))
      (sql/eval db "CREATE VIRTUAL TABLE IF NOT EXISTS tokens USING fts5(text,tokenize='unicode61 remove_diacritics 0'); CREATE VIRTUAL TABLE IF NOT EXISTS words USING fts5vocab(tokens,'instance'); DELETE FROM tokens;")
      (sql/eval db "INSERT INTO tokens(text) VALUES(?)" [query])
      (def stops (get (json/decode (slurp (c :stopwords)) true true) (keyword (c :language))))
      (assert (> (length stops) 0) "unsupported stopword language")
      (def terms (map |($ :term) (sql/eval db "SELECT term FROM words WHERE term NOT IN (SELECT value FROM json_each(?)) GROUP BY term ORDER BY min(offset) LIMIT ?" [(config/encode stops) (c :terms)])))
      (when (> (length terms) 0)
        (def graph (sql/open (string (store/uri (c :cygnet)) "?mode=ro")))
        (defer (sql/close graph)
          (sql/eval graph "PRAGMA trusted_schema=OFF; PRAGMA query_only=ON;")
          (assert (and (= 1 (((sql/eval graph "PRAGMA user_version") 0) :user_version))
            (= 1514751817 (((sql/eval graph "PRAGMA application_id") 0) :application_id))
            (= (c :cygnet-source) (((sql/eval graph "SELECT value FROM metadata WHERE key='source_identity'") 0) :value))) "incompatible Cygnet asset")
          (each r (sql/eval graph `WITH RECURSIVE reachable(concept,depth) AS (
            SELECT concept,0 FROM form_concepts WHERE language=? AND form IN (SELECT value FROM json_each(?))
            UNION SELECT e.target,r.depth+1 FROM reachable r JOIN concept_edges e ON e.source=r.concept WHERE r.depth<? LIMIT ?)
            SELECT DISTINCT f.form FROM reachable r JOIN form_concepts f ON f.concept=r.concept WHERE f.language=? ORDER BY f.form LIMIT ?`
            [(c :language) (config/encode terms) (c :expansion-depth) (c :expansion-nodes) (c :language) (c :terms)])
            (when (and (< (length terms) (c :terms)) (not (index-of (r :form) stops)) (not (index-of (r :form) terms))) (array/push terms (r :form))))))
      (sql/eval db "DELETE FROM tokens")
      (each [i row] (pairs rows) (sql/eval db "INSERT INTO tokens(rowid,text) VALUES(?,?)" [(+ i 1) (row :text)]))
      (def fuzzy (sql/eval db `WITH RECURSIVE grams(word,pos) AS (SELECT value,1 FROM json_each(?) WHERE length(value)>=3
        UNION ALL SELECT word,pos+1 FROM grams WHERE pos+2<length(word))
        SELECT DISTINCT term FROM words WHERE term NOT IN (SELECT value FROM json_each(?))
        AND EXISTS(SELECT 1 FROM grams WHERE instr(term,substr(word,pos,3))>0) ORDER BY term LIMIT ?`
        [(config/encode terms) (config/encode stops) (c :terms)]))
      (def words (distinct (array/concat @[] terms (map |($ :term) fuzzy))))
      (if (empty? words) [] (map (fn [hit]
        (def text (hit :excerpt)) (var end (min (length text) (c :page-bytes)))
        (while (and (< end (length text)) (<= 0x80 (text end) 0xbf)) (++ end))
        (merge (rows (- (hit :rowid) 1)) {:text (string/slice text 0 end)}))
        (sql/eval db "SELECT rowid,snippet(tokens,0,'','',' … ',64) excerpt FROM tokens WHERE tokens MATCH ? ORDER BY rank,rowid LIMIT ?"
          [(string/join (map |(string "\"" (string/replace-all "\"" "\"\"" $) "\"") words) " OR ") (c :candidates)]))))))
(defn plan [s roots c query room]
  (label planned
    (def budget (if (c :memory-retrieval) (math/floor (* room 0.7)) room))
    (var nodes (map |(representation s $ c) roots))
    (while (> (model/estimate (map |($ :text) nodes)) budget)
      (def next (find |(not ($ :summary)) nodes))
      (when next (return planned {:summary (need s (next :node) c)}))
      (assert (> (length nodes) 1) "minimum memory summary exceeds context budget")
      (set nodes [(representation s (combine s roots) c)]))
    (def covered @{})
    (each n nodes (unless (n :summary) (each p (pages s (n :node))
      (put covered (p :source) (+ (get covered (p :source) 0) (- (p :end) (p :start)))))))
    (def eligible (filter |(< (get covered ($ :reference) 0) (length ($ :text))) (sources s roots)))
    {:nodes nodes :room room :candidates (candidates s eligible query c) :memory roots}))
(defn finish [plan ranks c]
  (def evidence @[]) (def decisions @[]) (var cost (model/estimate (map |($ :text) (plan :nodes))))
  (each rank ranks
    (def row ((plan :candidates) (rank :index))) (def size (model/estimate (row :text)))
    (def decision (cond (< (rank :relevance_score) (c :score)) "below-cutoff" (> (+ cost size) (plan :room)) "budget" "included"))
    (when (= decision "included") (array/push evidence row) (+= cost size))
    (array/push decisions {:reference (row :reference) :score (rank :relevance_score) :decision decision}))
  {:chronological (string/join (map |($ :text) (plan :nodes)) "\n\n")
   :semantic (string/join (map |(string "[@" ($ :reference) "] " ($ :text)) evidence) "\n\n")
   :manifest {:memory (plan :memory) :nodes (plan :nodes) :retrieval decisions}})

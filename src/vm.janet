(import ./config)
(import ./agent)
(import ./memory)

(def modules [[(require "./agent") 'agent] [(require "./memory") 'memory] [(require "./config") 'config]])
(defn render [env definitions]
  (string/join (seq [name :in (sorted (all-bindings env true))]
    (def value (module/value env name true))
    (if (index-of (type value) [:function :cfunction])
      (do (assert (definitions name) (string "definition source unavailable for " name)) (definitions name))
      (string "(" (if (and (definitions name) (= 'var (first (first (parse-all (definitions name)))))) "var" "def") " " name " " (string/format "%j" value) ")"))) "\n\n"))
(defn definition [form name]
  (when (tuple? form)
    (if (and (index-of (first form) '[def var defn defn- defmacro defmacro-]) (= name (get form 1))) form
      (some |(definition $ name) form))))
(defn step [p]
  (try (do
    (def c (p :config)) (def bindings (p :bindings)) (def input (p :input)) (def request (p :request))
    (def base @{:redef true}) (def native (make-env)) (var env nil) (var definitions nil)
    (def output @"")
    (each port [:out :err] (put base port (fn [text]
      (assert (<= (+ (length output) (length text)) (c :response-bytes)) "script output limit") (buffer/push-string output text))))
    (def invoke (fn [name args]
      (when (string? name)
        (assert (bindings name) {:code "BindingNotGranted" :message (string "Binding is not granted: " name)})
        (when-let [[minimum maximum] (get-in bindings [name :arity])]
          (assert (<= minimum (length args) maximum) "wrong argument count")))
      (def r (yield {:binding name :arguments args}))
      (if (= "ok" (r :status)) (r :value) (error (r :error)))))
    (def evaluate (fn [code]
      (var value nil)
      (each form (parse-all code)
        (def before (tabseq [name :in (all-bindings env true)] name (env name)))
        (def thunk (compile form env))
        (when (dictionary? thunk) (error {:code "CompileFailed" :message (thunk :error)}))
        (set value (thunk))
        (each name (all-bindings env true) (unless (= (before name) (env name))
          (when-let [source (definition form name)] (put definitions name (string/format "%j" source)))))) value))
    (each [name spec] (pairs bindings)
      (put base (symbol name) (case (spec :class)
        "native" (native (spec :native))
        "macro" @{:macro true :value config/gather :doc (spec :doc)}
        @{:doc (spec :doc) :value (if (= name "memory/summarize") (partial agent/manual invoke)
          (fn [& args] (invoke name args)))})))
    (def reverse (merge make-image-dict {base 'zinc/base invoke 'zinc/invoke evaluate 'zinc/evaluate}))
    (def forward (merge load-image-dict {'zinc/base base 'zinc/invoke invoke 'zinc/evaluate evaluate}))
    (each [module namespace] modules (each [name binding] (pairs module)
      (when (and (symbol? name) (binding :value))
        (def alias (symbol "zinc/" namespace "/" name))
        (put reverse (binding :value) alias) (put forward alias (binding :value)))))
    (each [name binding] (pairs base) (when (symbol? name)
      (def alias (symbol "zinc/binding/" name)) (put reverse binding alias) (put forward alias binding)
      (when (binding :value) (def key (symbol "zinc/value/" name))
        (put reverse (binding :value) key) (put forward key (binding :value)))))
    (def machine (if (p :image) (unmarshal (p :image) forward) @{:env (make-env base) :definitions @{}}))
    (set env (machine :env)) (set definitions (machine :definitions))
    (assert (= base (table/getproto env)) "invalid machine environment")
    (when (p :view) (break {:view (render env definitions)}))
    (def before (marshal (seq [name :in (sorted (all-bindings env true))]
      [name (module/value env name true) (definitions name)]) reverse))
    (when (p :starting)
      (put machine :tasks @[@{:fiber (fiber/new (fn [] (if (input :code) (evaluate (input :code))
        (agent/run input invoke evaluate (c :rounds)))) :a env)}]) (put machine :cursor 0))
    (def tasks (machine :tasks))
    (when-let [[index response] (p :reply)] (put (tasks index) :wait nil) (put (tasks index) :inbox response))
    (sandbox :fs :net :subprocess :ffi :modules :env :asm :unmarshal :exit :locale :signal :threads :sandbox)
    (when (> (c :seconds) 0) (ev/deadline (c :seconds) (fiber/root) (fiber/root) true))
    (var operation nil) (var host-task nil)
    (while (not operation)
      (var chosen nil)
      (for offset 0 (length tasks)
        (def i (mod (+ (machine :cursor) offset) (length tasks))) (def task (tasks i))
        (unless (task :outcome)
          (def wait (task :wait))
          (def response (cond (nil? wait) (get task :inbox {:status "ok"})
            (has-key? wait :task) (let [target (get tasks (wait :task))]
              (assert (= request (wait :scope)) "task belongs to another inquiry")
              (when (target :outcome) (put target :observed true) (target :outcome)))
            (has-key? wait :call) (get-in (p :calls) [(wait :call) :result])
            (has-key? wait :request) (get (p :results) (wait :request))
            (has-key? wait :timer) (when (<= (wait :timer) (p :now)) {:status "ok"})))
          (when response (set chosen [i task response]) (break))))
      (unless chosen (break))
      (def [i task response] chosen) (put machine :cursor (mod (+ i 1) (length tasks)))
      (put task :wait nil) (put task :inbox nil)
      (def fiber (task :fiber)) (def value (resume fiber (unless (= :new (fiber/status fiber)) response)))
      (case (fiber/status fiber)
        :dead (put task :outcome {:status "ok" :value value})
        :error (put task :outcome {:status "error" :error (config/diagnostic value fiber)})
        :pending (do
          (def name (value :binding)) (def args (value :arguments))
          (case name
            "input" (put task :inbox {:status "ok" :value input})
            "settings" (put task :inbox {:status "ok" :value ((config/expose c bindings) :settings)})
            "resources" (put task :inbox {:status "ok" :value ((config/expose c bindings) :resources)})
            "ev/go" (do (assert (function? (first args)) "ev/go expects a Janet function")
              (assert (< (length tasks) (c :tasks)) "task limit")
              (def id (length tasks)) (array/push tasks @{:fiber (fiber/new (first args) :a env)})
              (put task :inbox {:status "ok" :value {:scope request :task id}}))
            "ev/sleep" (do (assert (and (number? (first args)) (<= 0 (first args) 31536000)) "invalid sleep duration")
              (put task :wait {:timer (+ (p :now) (first args))}))
            "await" (let [ref (first args)]
              (if (and (dictionary? ref) (has-key? ref :task))
                (do (put task :wait ref) (var at ref) (def seen @{})
                  (while (and at (has-key? at :task))
                    (def id (at :task)) (assert (and (= request (at :scope)) (int? id) (<= 0 id (- (length tasks) 1))
                      (not= id i) (not (seen id))) {:code "WaitCycle" :message "Invalid or cyclic task wait."})
                    (put seen id true) (set at (get-in tasks [id :wait]))))
                (do (assert (and (dictionary? ref) (string? (ref :request)) (int? (ref :path))) "await expects a task or work reference")
                  (set operation {:binding :await :arguments [ref]}) (set host-task i) (put task :wait ref))))
            "world/view" (if (first args)
              (do (set operation value) (set host-task i) (put task :wait {:host true}))
              (put task :inbox {:status "ok" :value (render env definitions)}))
            "world/remove" (do (assert (symbol? (first args)) "world/remove expects a symbol")
              (put env (first args) nil) (put definitions (first args) nil) (put task :inbox {:status "ok" :value true}))
            (do (config/encode args) (set operation value) (set host-task i)
              (put task :wait (if (or (index-of name [:chat :rerank]) (= "external" (get-in bindings [name :class])))
                {:call (length (p :calls))} {:host true})))) )
        (error "unsupported fiber suspension")))
    (def settled (when (every? (map |($ :outcome) tasks))
      (or (get (find |(and (not ($ :observed)) (= "error" (get-in $ [:outcome :status]))) tasks) :outcome) ((tasks 0) :outcome))))
    (when settled (config/encode settled))
    (def image (marshal machine reverse))
    (assert (<= (length image) (c :world-bytes)) "machine image limit")
    (def projected (marshal @{:env env :definitions definitions} reverse))
    (def after (marshal (seq [name :in (sorted (all-bindings env true))]
      [name (module/value env name true) (definitions name)]) reverse))
    {:image image :changed (not= (string before) (string after)) :bindings projected
     :operation operation :task host-task :output (string output) :settled settled
     :waits (seq [task :in tasks :unless (task :outcome) :when (task :wait)] (task :wait))})
    ([err fiber] {:failure (config/diagnostic err fiber)})))

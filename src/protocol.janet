(import spork/json :as json)
(import spork/utf8 :as utf8)
(import ./schema)

(defn validate [value]
  (assert (and (dictionary? value) (= 1 (value :version))) "invalid protocol version")
  (def fields (get {:call [:method :params] :ready [] :event [:value] :result [:value] :error [:error]} (keyword (value :type))))
  (assert fields "invalid message type")
  (each key fields (assert (has-key? value key) "missing message field"))
  (each key (keys value) (assert (index-of key (array/concat @[:version :type] fields)) "unknown message field"))
  (when (= "call" (value :type)) (assert (and (string? (value :method)) (> (length (value :method)) 0)) "invalid method"))
  (when (= "error" (value :type))
    (def failure (value :error))
    (assert (and (dictionary? failure) (string? (failure :code)) (string? (failure :message))) "invalid diagnostic")
    (each key (keys failure) (assert (index-of key [:code :message :detail :context]) "unknown diagnostic field"))
    (when (has-key? failure :detail) (assert (string? (failure :detail)) "invalid diagnostic detail"))
    (when (has-key? failure :context) (assert (dictionary? (failure :context)) "invalid diagnostic context")))
  value)

(defn reader [io] @{:io io :bytes @""})

(defn receive [state limit]
  (assert (and (int? limit) (<= 1 limit 0x7fffffff)) "invalid frame limit")
  (var newline (string/find "\n" (state :bytes)))
  (while (nil? newline)
    (assert (< (length (state :bytes)) limit) "frame exceeds byte limit")
    (def chunk (:read (state :io) (min 4096 (- limit (length (state :bytes))))))
    (unless chunk (assert (= 0 (length (state :bytes))) "partial protocol frame") (break))
    (buffer/push-string (state :bytes) chunk)
    (set newline (string/find "\n" (state :bytes))))
  (when newline
    (def bytes (string/slice (state :bytes) 0 newline))
    (put state :bytes (buffer (string/slice (state :bytes) (+ newline 1))))
    (assert (utf8/is-valid? bytes) "invalid UTF-8")
    (validate (json/decode bytes true))))

(defn send [io value limit]
  (validate value)
  (def bytes (string (schema/encode value) "\n"))
  (assert (and (<= (length bytes) limit) (utf8/is-valid? bytes)) "frame exceeds byte limit")
  (:write io bytes)
  (when (get io :flush) (:flush io)))

(defn diagnostic [code err &opt fiber]
  (def trace @"")
  (when fiber (with-dyns [:err trace] (debug/stacktrace fiber)))
  (def value (if (and (dictionary? err) (string? (err :code)) (string? (err :message))) err
                {:code code :message (if (string? err) err (string/format "%n" err))}))
  (merge (schema/project value [:code :message])
    (if (dictionary? (value :context)) {:context (value :context)} {})
    {:detail (string (get value :detail "") "\n" trace)}))

(defn call [spec name args operation limit]
  (def process (os/spawn (spec :command) :pd {:in :pipe :out :pipe :err stderr}))
  (def finished (ev/chan 1))
  (ev/go (fn [] (os/proc-wait process)) nil finished)
  (defer (do (ev/close (process :in)) (ev/close (process :out)))
    (ev/with-deadline (if (= 0 (get spec :timeoutSeconds 0)) math/inf (spec :timeoutSeconds))
      (send (process :in) {:version 1 :type "call" :method name :params {:arguments args :operation operation}} limit)
      (ev/close (process :in))
      (var ready false) (var terminal nil) (var frame nil)
      (def output (reader (process :out)))
      (while (set frame (receive output limit))
        (assert (nil? terminal) "trailing terminal bytes")
        (case (frame :type)
          "ready" (do (assert (not ready) "duplicate readiness") (set ready true))
          "event" (assert ready "missing readiness")
          "result" (do (assert ready "missing readiness") (set terminal frame))
          "error" (set terminal frame)
          (error "invalid response message")))
      (assert terminal "missing terminal response")
      (ev/take finished)
      (when (= "error" (terminal :type)) (error (terminal :error)))
      (assert (= 0 (process :return-code)) "capability process failed; effects may have happened")
      (terminal :value))))

{
  "tasks": {
    "check": "deno fmt --check && deno lint && deno test --allow-all",
    "test": "deno test --allow-all",
    "bench": "deno bench --allow-all"
  },
  "fmt": {
    "lineWidth": 110
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/path": "jsr:@std/path@1.1.4",
    "mdast": "npm:@types/mdast@4.0.4",
    "mdast-util-from-markdown": "npm:mdast-util-from-markdown@2.0.3",
    "mdast-util-gfm": "npm:mdast-util-gfm@3.1.0",
    "micromark-extension-gfm": "npm:micromark-extension-gfm@3.0.0"
  }
}
